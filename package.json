    "postbuild": "npx pagefind --site dist && node scripts/prune-pagefind-assets.js",
    "preview": "astro preview",
    "astro": "astro",
    "test:article-slugmap": "node scripts/check-article-slugmap.js",
    "test:warm-function": "node scripts/check-warm-function.js",
    "test:history-parser": "node scripts/check-history-parser.js",
    "test:history-privacy": "node scripts/check-history-privacy.js",
    "test:content-sanitizer": "node scripts/check-content-sanitizer.js",
    "test:sync-article-paths": "node scripts/check-sync-article-paths.js",
    "test:sync-categories": "node scripts/check-sync-categories.js",
    "test:sync-json-assets": "node scripts/check-sync-json-assets.js",
    "test:article-image-assets": "node scripts/check-article-image-assets.js",
    "test:linkgraph-infobox": "node scripts/check-linkgraph-infobox-json.js",
    "test:wiki-link-resolver": "node scripts/check-wiki-link-resolver.js",
    "test:article-script-placement": "node scripts/check-article-script-placement.js",
    "test:skip-link": "node scripts/check-skip-link.js",
    "test:robots": "node scripts/check-robots.js",
    "test:mobile-header-search": "node scripts/check-mobile-header-search.js",
    "test:structured-data": "node scripts/check-structured-data.js",
    "test:opensearch": "node scripts/check-opensearch.js",
    "test:search-data": "node scripts/check-search-data.js",
    "test:external-links": "node scripts/check-external-links.js",
    "test:search-prefill": "node scripts/check-search-prefill.js",
    "test:csp": "node scripts/check-csp.js",
    "test:title-sort": "node scripts/check-title-sort.js",
    "test:allpages-directory": "node scripts/check-allpages-directory.js",
    "test:og-text-layout": "node scripts/check-og-text-layout.js",
    "test:md-article": "node scripts/check-md-article.js",
    "test:history-date": "node scripts/check-history-date.js",
    "test:home-links": "node scripts/check-home-links.js",
    "test:404": "node scripts/check-404.js",
    "test:security-txt": "node scripts/check-security-txt.js"
