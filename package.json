{
  "name": "taopedia",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "node scripts/sync-articles.js",
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "node scripts/sync-articles.js && node scripts/generate-history.js && node scripts/build-linkgraph.js",
    "postbuild": "npx pagefind --site dist && node scripts/prune-pagefind-assets.js",
    "preview": "astro preview",
    "astro": "astro",
    "test:article-slugmap": "node scripts/check-article-slugmap.js",
    "test:warm-function": "node scripts/check-warm-function.js",
    "test:history-parser": "node scripts/check-history-parser.js",
    "test:content-sanitizer": "node scripts/check-content-sanitizer.js",
    "test:sync-article-paths": "node scripts/check-sync-article-paths.js",
    "test:sync-categories": "node scripts/check-sync-categories.js",
    "test:robots": "node scripts/check-robots.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.3.8",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.2.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "remark-wiki-link": "^2.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
