---
import '../styles/wikipedia.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - Taopedia` : 'Taopedia';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taopedia" />
    <style>
      /* Header Logo Animation Styles */
      .mw-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        font-size: 16px;
        font-weight: 600;
        color: var(--color-base);
        margin-right: 32px;
      }
      
      .header-logo-container {
        position: relative;
        width: 40px;
        height: 40px;
        margin-right: 8px;
      }
      
      .header-globe {
        position: relative;
        width: 40px;
        height: 40px;
        background: transparent;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: visible;
        z-index: 10;
      }
      
      /* Elegant aura: radial inner glow + rotating conic-gradient ring */
      .header-globe::before {
        content: "";
        position: absolute;
        top: 50%; left: 50%;
        width: 48px; height: 48px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: radial-gradient(closest-side, rgba(255,255,255,0.85), rgba(255,255,255,0) 70%);
        pointer-events: none; z-index: 0;
      }
      
      .header-globe::after {
        content: "";
        position: absolute;
        top: 50%; left: 50%;
        width: 54px; height: 54px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: conic-gradient(from 0deg, rgba(51,102,204,0.35), rgba(51,102,204,0) 40%, rgba(51,102,204,0.35) 80%, rgba(51,102,204,0.35));
        filter: blur(3px);
        animation: header-spin 12s linear infinite;
        pointer-events: none; z-index: 0;
      }
      
      @keyframes header-spin { 
        to { transform: translate(-50%, -50%) rotate(360deg); } 
      }
      
      .header-logo-img {
        position: relative;
        z-index: 1;
        width: 24px;
        height: auto;
      }
      
      .header-logo-text {
        font-family: var(--font-family-serif);
        font-weight: 400;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
      
      .logo-letter-large {
        font-size: 1.2em;
        font-weight: 500;
      }
      
      /* Reduced motion: freeze rotation */
      @media (prefers-reduced-motion: reduce) {
        .header-globe::after { 
          animation: none; 
        }
      }
      
      /* Responsive scaling */
      @media (max-width: 768px) {
        .header-logo-container {
          width: 36px;
          height: 36px;
        }
        
        .header-globe {
          width: 36px;
          height: 36px;
        }
        
        .header-globe::before {
          width: 42px; 
          height: 42px;
        }
        
        .header-globe::after {
          width: 48px; 
          height: 48px;
        }
        
        .header-logo-img {
          width: 20px;
        }
        
        .mw-logo {
          font-size: 14px;
        }
        
        .logo-letter-large {
          font-size: 1.15em;
        }
      }
      
      @media (max-width: 480px) {
        .header-logo-container {
          width: 32px;
          height: 32px;
        }
        
        .header-globe {
          width: 32px;
          height: 32px;
        }
        
        .header-globe::before {
          width: 38px; 
          height: 38px;
        }
        
        .header-globe::after {
          width: 42px; 
          height: 42px;
        }
        
        .header-logo-img {
          width: 18px;
        }
        
        .mw-logo {
          font-size: 13px;
          margin-right: 16px;
        }
        
        .logo-letter-large {
          font-size: 1.1em;
        }
      }
    </style>
  </head>
  <body>
    <!-- Sidebar toggle button -->
    <button class="sidebar-toggle" aria-label="Toggle navigation">☰</button>
    
    <!-- Right rail toggle button -->
    <button class="right-rail-toggle" aria-label="Toggle appearance settings">⚙</button>
    
    <!-- Overlays -->
    <div class="sidebar-overlay"></div>
    <div class="right-rail-overlay"></div>
    
    <header class="mw-header">
      <div class="mw-header-content">
        <div class="mw-header-left">
          <a href="/" class="mw-logo">
            <div class="header-logo-container">
              <div class="header-globe">
                <img src="/logo.svg" alt="Taopedia logo" class="header-logo-img" />
              </div>
            </div>
            <span class="header-logo-text">
            <span class="logo-letter-large">T</span>AOPEDI<span class="logo-letter-large">A</span>
          </span>
          </a>
        </div>
        
        <div class="mw-header-center">
          <div class="mw-header-center-inner">
            <div class="mw-search-container">
              <form action="/search" method="get" style="position: relative;">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; opacity: 0.5;">
                  <path d="M7 12C9.76142 12 12 9.76142 12 7C12 4.23858 9.76142 2 7 2C4.23858 2 2 4.23858 2 7C2 9.76142 4.23858 12 7 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <input 
                  type="search" 
                  name="q" 
                  class="mw-search-input" 
                  placeholder="Search Taopedia" 
                  aria-label="Search"
                  style="padding-left: 36px;"
                />
              </form>
            </div>
          </div>
        </div>
        
        <div class="mw-header-right">
          <nav>
            <a href="/wiki/Special:AllPages" style="margin-left: 16px; color: var(--color-base); text-decoration: none; font-size: 13px;">All pages</a>
            <a href="/wiki/Special:RecentChanges" style="margin-left: 16px; color: var(--color-base); text-decoration: none; font-size: 13px;">Recent changes</a>
          </nav>
        </div>
      </div>
    </header>

    <div class="mw-page-container">
      <div class="mw-content-container">
        <aside class="mw-sidebar">
          <nav class="mw-sidebar-nav">
            <div class="mw-sidebar-section">
              <h3 class="mw-sidebar-heading">Navigation</h3>
              <ul class="mw-sidebar-list">
                <li><a href="/">Main page</a></li>
                <li><a href="/wiki/Special:AllPages">All pages</a></li>
                <li><a href="/wiki/Special:Categories">Categories</a></li>
                <li><a href="/wiki/Special:RecentChanges">Recent changes</a></li>
              </ul>
            </div>
            
            <div class="mw-sidebar-section">
              <h3 class="mw-sidebar-heading">Community</h3>
              <ul class="mw-sidebar-list">
                <li><a href="/wiki/Taopedia:About">About Taopedia</a></li>
                <li><a href="/wiki/Taopedia:Help">Help</a></li>
                <li><a href="https://github.com/grant/taopedia" target="_blank">Contribute</a></li>
              </ul>
            </div>
          </nav>
        </aside>

        <main class="mw-body">
          <slot />
        </main>

        <aside class="mw-right-rail">
          <div class="mw-right-rail-inner">
            <div class="panel-header">
              <span>Appearance</span>
              <button type="button" style="border: 1px solid var(--border-color-subtle); background: var(--background-color-interactive); font-size: 12px; padding: 2px 6px; border-radius: 2px; cursor: pointer;">hide</button>
            </div>
            <div class="panel-section">
              <h4>Text</h4>
              <label class="option"><input type="radio" name="ap-text" value="small" /> Small</label>
              <label class="option"><input type="radio" name="ap-text" value="standard" checked /> Standard</label>
              <label class="option"><input type="radio" name="ap-text" value="large" /> Large</label>
            </div>
            <div class="divider"></div>
            <div class="panel-section">
              <h4>Width</h4>
              <label class="option"><input type="radio" name="ap-width" value="narrow" /> Narrow</label>
              <label class="option"><input type="radio" name="ap-width" value="standard" checked /> Standard</label>
              <label class="option"><input type="radio" name="ap-width" value="wide" /> Wide</label>
            </div>
            <div class="divider"></div>
            <div class="panel-section">
              <h4>Color (beta)</h4>
              <label class="option"><input type="radio" name="ap-color" /> Automatic</label>
              <label class="option"><input type="radio" name="ap-color" checked /> Light</label>
              <label class="option"><input type="radio" name="ap-color" /> Dark</label>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <footer class="mw-footer">
      <div class="mw-footer-links">
        <a href="/wiki/Taopedia:About">About Taopedia</a>
        <a href="/wiki/Taopedia:Privacy">Privacy policy</a>
        <a href="/wiki/Taopedia:Disclaimer">Disclaimers</a>
        <a href="https://github.com/grant/taopedia" target="_blank">Source code</a>
        <span style="margin-left: auto;">Content available under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></span>
      </div>
    </footer>

    <script>
      // Appearance controls functionality
      document.addEventListener('DOMContentLoaded', function() {
        const textRadios = document.querySelectorAll('input[name="ap-text"]');
        const widthRadios = document.querySelectorAll('input[name="ap-width"]');
        const articleBody = document.querySelector('.mw-body');
        
        // Sidebar toggle functionality
        const sidebarToggle = document.querySelector('.sidebar-toggle');
        const sidebar = document.querySelector('.mw-sidebar');
        const sidebarOverlay = document.querySelector('.sidebar-overlay');
        
        const rightRailToggle = document.querySelector('.right-rail-toggle');
        const rightRail = document.querySelector('.mw-right-rail');
        const rightRailOverlay = document.querySelector('.right-rail-overlay');
        
        // Toggle sidebar
        if (sidebarToggle && sidebar && sidebarOverlay) {
          sidebarToggle.addEventListener('click', function() {
            sidebar.classList.toggle('mobile-active');
            sidebarOverlay.classList.toggle('active');
          });
          
          sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('mobile-active');
            sidebarOverlay.classList.remove('active');
          });
        }
        
        // Toggle right rail
        if (rightRailToggle && rightRail && rightRailOverlay) {
          rightRailToggle.addEventListener('click', function() {
            rightRail.classList.toggle('mobile-active');
            rightRailOverlay.classList.toggle('active');
          });
          
          rightRailOverlay.addEventListener('click', function() {
            rightRail.classList.remove('mobile-active');
            rightRailOverlay.classList.remove('active');
          });
        }
        
        // Set initial state
        articleBody.classList.add('text-standard', 'width-standard');
        
        // Text size controls
        textRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            if (this.checked) {
              // Remove all text size classes
              articleBody.classList.remove('text-small', 'text-standard', 'text-large');
              // Add the selected text size class
              articleBody.classList.add('text-' + this.value);
              
              // Store preference in localStorage
              localStorage.setItem('taopedia-text-size', this.value);
            }
          });
        });
        
        // Width controls
        widthRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            if (this.checked) {
              // Remove all width classes
              articleBody.classList.remove('width-narrow', 'width-standard', 'width-wide');
              // Add the selected width class
              articleBody.classList.add('width-' + this.value);
              
              // Store preference in localStorage
              localStorage.setItem('taopedia-width', this.value);
            }
          });
        });
        
        // Load saved preferences
        const savedTextSize = localStorage.getItem('taopedia-text-size');
        if (savedTextSize) {
          const savedRadio = document.querySelector(`input[name="ap-text"][value="${savedTextSize}"]`);
          if (savedRadio) {
            savedRadio.checked = true;
            articleBody.classList.remove('text-small', 'text-standard', 'text-large');
            articleBody.classList.add('text-' + savedTextSize);
          }
        }
        
        const savedWidth = localStorage.getItem('taopedia-width');
        if (savedWidth) {
          const savedRadio = document.querySelector(`input[name="ap-width"][value="${savedWidth}"]`);
          if (savedRadio) {
            savedRadio.checked = true;
            articleBody.classList.remove('width-narrow', 'width-standard', 'width-wide');
            articleBody.classList.add('width-' + savedWidth);
          }
        }
      });
    </script>
  </body>
</html>
