---
import '../styles/wikipedia.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - Taopedia` : 'Taopedia';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taopedia" />
    <style>
      /* Header Logo Animation Styles */
      .mw-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        font-size: 16px;
        font-weight: 600;
        color: var(--color-base);
        margin-right: 32px;
      }
      
      .header-logo-container {
        position: relative;
        width: 40px;
        height: 40px;
        margin-right: 8px;
      }
      
      .header-globe {
        position: relative;
        width: 40px;
        height: 40px;
        background: transparent;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: visible;
        z-index: 10;
      }
      
      /* Elegant aura: radial inner glow + rotating conic-gradient ring */
      .header-globe::before {
        content: "";
        position: absolute;
        top: 50%; left: 50%;
        width: 48px; height: 48px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: radial-gradient(closest-side, rgba(255,255,255,0.85), rgba(255,255,255,0) 70%);
        pointer-events: none; z-index: 0;
      }
      
      .header-globe::after {
        content: "";
        position: absolute;
        top: 50%; left: 50%;
        width: 54px; height: 54px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: conic-gradient(from 0deg, rgba(51,102,204,0.35), rgba(51,102,204,0) 40%, rgba(51,102,204,0.35) 80%, rgba(51,102,204,0.35));
        filter: blur(3px);
        animation: header-spin 12s linear infinite;
        pointer-events: none; z-index: 0;
      }
      
      @keyframes header-spin { 
        to { transform: translate(-50%, -50%) rotate(360deg); } 
      }
      
      .header-logo-img {
        position: relative;
        z-index: 1;
        width: 24px;
        height: auto;
      }
      
      .header-logo-text {
        font-family: var(--font-family-serif);
        font-weight: 400;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
      
      .logo-letter-large {
        font-size: 1.2em;
        font-weight: 500;
      }
      
      /* Reduced motion: freeze rotation */
      @media (prefers-reduced-motion: reduce) {
        .header-globe::after { 
          animation: none; 
        }
      }
      
      /* Responsive scaling */
      @media (max-width: 768px) {
        .header-logo-container {
          width: 36px;
          height: 36px;
        }
        
        .header-globe {
          width: 36px;
          height: 36px;
        }
        
        .header-globe::before {
          width: 42px; 
          height: 42px;
        }
        
        .header-globe::after {
          width: 48px; 
          height: 48px;
        }
        
        .header-logo-img {
          width: 20px;
        }
        
        .mw-logo {
          font-size: 14px;
        }
        
        .logo-letter-large {
          font-size: 1.15em;
        }
      }
      
      @media (max-width: 480px) {
        .header-logo-container {
          width: 32px;
          height: 32px;
        }
        
        .header-globe {
          width: 32px;
          height: 32px;
        }
        
        .header-globe::before {
          width: 38px; 
          height: 38px;
        }
        
        .header-globe::after {
          width: 42px; 
          height: 42px;
        }
        
        .header-logo-img {
          width: 18px;
        }
        
        .mw-logo {
          font-size: 13px;
          margin-right: 16px;
        }
        
        .logo-letter-large {
          font-size: 1.1em;
        }
      }
    </style>
  </head>
  <body>
    <!-- Sidebar/right-rail toggles are placed within page toolbars now -->
    
    <!-- Overlays -->
    <div class="sidebar-overlay"></div>
    <div class="right-rail-overlay"></div>
    
    <header class="mw-header">
      <div class="mw-header-content">
        <div class="mw-header-left">
          <a href="/" class="mw-logo">
            <div class="header-logo-container">
              <div class="header-globe">
                <img src="/logo.svg" alt="Taopedia logo" class="header-logo-img" />
              </div>
            </div>
            <span class="header-logo-text">
            <span class="logo-letter-large">T</span>AOPEDI<span class="logo-letter-large">A</span>
          </span>
          </a>
        </div>
        
        <div class="mw-header-center">
          <div class="mw-header-center-inner">
            <div class="mw-search-container">
              <form action="/search" method="get" style="position: relative;">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; opacity: 0.5;">
                  <path d="M7 12C9.76142 12 12 9.76142 12 7C12 4.23858 9.76142 2 7 2C4.23858 2 2 4.23858 2 7C2 9.76142 4.23858 12 7 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <input 
                  type="search" 
                  name="q" 
                  class="mw-search-input" 
                  placeholder="Search Taopedia" 
                  aria-label="Search"
                  style="padding-left: 36px;"
                />
              </form>
            </div>
          </div>
        </div>
        
        <div class="mw-header-right">
          <nav>
            <a href="/wiki/Special:AllPages" style="margin-left: 16px; color: var(--color-base); text-decoration: none; font-size: 13px;">All pages</a>
            <a href="/wiki/Special:RecentChanges" style="margin-left: 16px; color: var(--color-base); text-decoration: none; font-size: 13px;">Recent changes</a>
          </nav>
          <div class="nav-dropdown-container">
            <button class="nav-dropdown-toggle" aria-label="Navigation menu">☰</button>
            <div class="nav-dropdown-menu">
              <div class="nav-dropdown-section">
                <h3 class="nav-dropdown-heading">Navigation</h3>
                <ul class="nav-dropdown-list">
                  <li><a href="/">Main page</a></li>
                  <li><a href="/wiki/Special:AllPages">All pages</a></li>
                  <li><a href="/wiki/Special:Categories">Categories</a></li>
                  <li><a href="/wiki/Special:RecentChanges">Recent changes</a></li>
                </ul>
              </div>
              <div class="nav-dropdown-section">
                <h3 class="nav-dropdown-heading">Community</h3>
                <ul class="nav-dropdown-list">
                  <li><a href="/wiki/Taopedia:About">About Taopedia</a></li>
                  <li><a href="/wiki/Taopedia:Help">Help</a></li>
                  <li><a href="https://github.com/grant/taopedia" target="_blank">Contribute</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="mw-page-container">
      <div class="mw-content-container">
        <aside class="mw-sidebar">
          <slot name="sidebar" />
        </aside>

        <main class="mw-body">
          <slot />
        </main>

        <aside class="mw-right-rail">
          <div class="mw-right-rail-inner">
            <div class="panel-header">
              <span>Appearance</span>
              <button type="button" style="border: 1px solid var(--border-color-subtle); background: var(--background-color-interactive); font-size: 12px; padding: 2px 6px; border-radius: 2px; cursor: pointer;">hide</button>
            </div>
            <div class="panel-section">
              <h4>Text</h4>
              <label class="option"><input type="radio" name="ap-text" value="small" /> Small</label>
              <label class="option"><input type="radio" name="ap-text" value="standard" checked /> Standard</label>
              <label class="option"><input type="radio" name="ap-text" value="large" /> Large</label>
            </div>
            <div class="divider"></div>
            <div class="panel-section">
              <h4>Width</h4>
              <label class="option"><input type="radio" name="ap-width" value="narrow" /> Narrow</label>
              <label class="option"><input type="radio" name="ap-width" value="standard" checked /> Standard</label>
              <label class="option"><input type="radio" name="ap-width" value="wide" /> Wide</label>
            </div>
            <div class="divider"></div>
            <div class="panel-section">
              <h4>Color (beta)</h4>
              <label class="option"><input type="radio" name="ap-color" /> Automatic</label>
              <label class="option"><input type="radio" name="ap-color" checked /> Light</label>
              <label class="option"><input type="radio" name="ap-color" /> Dark</label>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <footer class="mw-footer">
      <div class="mw-footer-links">
        <a href="/wiki/Taopedia:About">About Taopedia</a>
        <a href="/wiki/Taopedia:Privacy">Privacy policy</a>
        <a href="/wiki/Taopedia:Disclaimer">Disclaimers</a>
        <a href="https://github.com/grant/taopedia" target="_blank">Source code</a>
        <span style="margin-left: auto;">Content available under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></span>
      </div>
    </footer>

    <script>
      // Navigation dropdown functionality
      document.addEventListener('DOMContentLoaded', function() {
        const navToggle = document.querySelector('.nav-dropdown-toggle');
        const navMenu = document.querySelector('.nav-dropdown-menu');
        
        if (navToggle && navMenu) {
          navToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            navMenu.classList.toggle('active');
          });
          
          // Close dropdown when clicking outside
          document.addEventListener('click', function(e) {
            if (!navToggle.contains(e.target) && !navMenu.contains(e.target)) {
              navMenu.classList.remove('active');
            }
          });
        }
        
        // TOC collapse/expand functionality
        const tocToggles = document.querySelectorAll('.toc-toggle');
        tocToggles.forEach(toggle => {
          toggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const parentLi = this.closest('li');
            const parentLevel = parseInt(parentLi.dataset.tocLevel);
            
            // Toggle collapsed state
            parentLi.classList.toggle('collapsed');
            
            // Find all subsections
            let nextLi = parentLi.nextElementSibling;
            while (nextLi && nextLi.dataset.tocLevel) {
              const nextLevel = parseInt(nextLi.dataset.tocLevel);
              
              // If we hit a same-level or higher-level heading, stop
              if (nextLevel <= parentLevel) {
                break;
              }
              
              // Toggle subsection visibility
              if (parentLi.classList.contains('collapsed')) {
                nextLi.style.display = 'none';
              } else {
                nextLi.style.display = 'flex';
              }
              
              nextLi = nextLi.nextElementSibling;
            }
          });
        });
        
        // Active section tracking for TOC
        const tocLinks = document.querySelectorAll('.toc-list a[href^="#"]');
        const headings = document.querySelectorAll('.mw-parser-output h2[id], .mw-parser-output h3[id], .mw-parser-output h4[id]');
        
        if (tocLinks.length > 0 && headings.length > 0) {
          // Create a map of heading IDs to TOC items
          const tocItemMap = new Map();
          tocLinks.forEach(link => {
            const id = link.getAttribute('href').substring(1);
            const li = link.closest('li');
            if (id && li) {
              tocItemMap.set(id, li);
            }
          });
          
          // Function to update active section
          function updateActiveSection() {
            let currentSection = null;
            const scrollPosition = window.scrollY + 100; // Offset for header
            
            // Find the current section based on scroll position
            for (let i = headings.length - 1; i >= 0; i--) {
              const heading = headings[i];
              if (heading.offsetTop <= scrollPosition) {
                currentSection = heading.id;
                break;
              }
            }
            
            // Update active class
            tocItemMap.forEach((li, id) => {
              if (id === currentSection) {
                li.classList.add('active');
              } else {
                li.classList.remove('active');
              }
            });
          }
          
          // Update on scroll with throttling
          let scrollTimeout;
          window.addEventListener('scroll', () => {
            if (scrollTimeout) {
              window.cancelAnimationFrame(scrollTimeout);
            }
            scrollTimeout = window.requestAnimationFrame(() => {
              updateActiveSection();
            });
          });
          
          // Update on load
          updateActiveSection();
        }
        
        // Appearance controls functionality
        const textRadios = document.querySelectorAll('input[name="ap-text"]');
        const widthRadios = document.querySelectorAll('input[name="ap-width"]');
        const articleBody = document.querySelector('.mw-body');
        
        // Sidebar toggle functionality
        const sidebarToggle = document.querySelector('.sidebar-toggle');
        const sidebar = document.querySelector('.mw-sidebar');
        const sidebarOverlay = document.querySelector('.sidebar-overlay');
        
        const rightRailToggle = document.querySelector('.right-rail-toggle');
        const rightRail = document.querySelector('.mw-right-rail');
        const rightRailOverlay = document.querySelector('.right-rail-overlay');
        const tocHideBtn = document.querySelector('.toc-hide');
        const rightRailHideBtn = document.querySelector('.mw-right-rail .panel-header button');
        
        // Helper functions for responsive behavior
        function isMobile() { return window.matchMedia('(max-width: 900px)').matches; }
        function isMidSize() { return window.matchMedia('(min-width: 901px) and (max-width: 1500px)').matches; }
        function currentWidthMode() {
          if (document.body.classList.contains('content-width-wide')) return 'wide';
          if (document.body.classList.contains('content-width-narrow')) return 'narrow';
          return 'standard';
        }
        function rightRailThresholdPx() {
          const mode = currentWidthMode();
          if (mode === 'wide') return 1850;    // Needs more room for 1200px article + rails
          if (mode === 'narrow') return 1350;  // 720px article
          return 1500;                          // 960px article (default)
        }
        function isRightRailHidden() {
          return window.matchMedia(`(max-width: ${rightRailThresholdPx()}px)`).matches;
        }

        // Toggle sidebar
        if (sidebarToggle && sidebar && sidebarOverlay) {
          sidebarToggle.addEventListener('click', function() {
            if (isMobile()) {
              // Mobile panel behavior
              sidebar.classList.toggle('mobile-active');
              sidebarOverlay.classList.toggle('active');
            } else if (isMidSize()) {
              // Mid-size: use mobile-style overlay but with desktop styling
              sidebar.classList.toggle('mobile-active');
              sidebarOverlay.classList.toggle('active');
            } else {
              // Large desktop: collapse behavior
              document.body.classList.toggle('sidebar-collapsed');
            }
          });
          
          sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('mobile-active');
            sidebarOverlay.classList.remove('active');
          });
        }
        
        // Toggle right rail
        if (rightRailToggle && rightRail && rightRailOverlay) {
          rightRailToggle.addEventListener('click', function() {
            if (isMobile()) {
              // Mobile panel behavior
              rightRail.classList.toggle('mobile-active');
              rightRailOverlay.classList.toggle('active');
            } else if (isRightRailHidden()) {
              // Mid-size or mobile: use overlay behavior
              rightRail.classList.toggle('mobile-active');
              rightRailOverlay.classList.toggle('active');
            } else {
              // Large desktop: collapse behavior
              document.body.classList.toggle('right-rail-collapsed');
            }
          });
          
          rightRailOverlay.addEventListener('click', function() {
            rightRail.classList.remove('mobile-active');
            rightRailOverlay.classList.remove('active');
          });
        }

        // TOC hide button collapses sidebar
        if (tocHideBtn) {
          tocHideBtn.addEventListener('click', function() {
            if (isMobile() || isMidSize()) {
              sidebar.classList.remove('mobile-active');
              sidebarOverlay.classList.remove('active');
            } else {
              document.body.classList.add('sidebar-collapsed');
            }
          });
        }

        // Right rail panel hide button collapses right rail
        if (rightRailHideBtn) {
          rightRailHideBtn.addEventListener('click', function() {
            if (isMobile() || isRightRailHidden()) {
              rightRail.classList.remove('mobile-active');
              rightRailOverlay.classList.remove('active');
            } else {
              document.body.classList.add('right-rail-collapsed');
            }
          });
        }

        // Clear collapse classes and overlays when switching between responsive modes
        const mq900 = window.matchMedia('(max-width: 900px)');
        const mq1350 = window.matchMedia('(max-width: 1350px)');
        const mq1500 = window.matchMedia('(max-width: 1500px)');
        const mq1700 = window.matchMedia('(max-width: 1700px)');
        const mq1850 = window.matchMedia('(max-width: 1850px)');
        
        function handleResponsiveChange() {
          // Always clear active overlays when switching modes
          sidebar.classList.remove('mobile-active');
          rightRail.classList.remove('mobile-active');
          sidebarOverlay.classList.remove('active');
          rightRailOverlay.classList.remove('active');

          // If we're in any overlay mode for the sidebar (<=1500) clear collapsed state
          if (isMobile() || mq1500.matches) {
            document.body.classList.remove('sidebar-collapsed');
          }
          // If right rail should be overlay (based on dynamic threshold), clear collapsed state
          if (isMobile() || isRightRailHidden()) {
            document.body.classList.remove('right-rail-collapsed');
          }
        }
        
        mq900.addEventListener('change', handleResponsiveChange);
        mq1350.addEventListener('change', handleResponsiveChange);
        mq1500.addEventListener('change', handleResponsiveChange);
        mq1700.addEventListener('change', handleResponsiveChange);
        mq1850.addEventListener('change', handleResponsiveChange);
        
        // Set initial state
        articleBody.classList.add('text-standard', 'width-standard');
        document.body.classList.add('content-width-standard');
        
        // Text size controls
        textRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            if (this.checked) {
              // Remove all text size classes
              articleBody.classList.remove('text-small', 'text-standard', 'text-large');
              // Add the selected text size class
              articleBody.classList.add('text-' + this.value);
              
              // Store preference in localStorage
              localStorage.setItem('taopedia-text-size', this.value);
            }
          });
        });
        
        // Width controls
        widthRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            if (this.checked) {
              // Remove all width classes
              articleBody.classList.remove('width-narrow', 'width-standard', 'width-wide');
              document.body.classList.remove('content-width-narrow', 'content-width-standard', 'content-width-wide');
              // Add the selected width class
              articleBody.classList.add('width-' + this.value);
              document.body.classList.add('content-width-' + this.value);
              
              // Store preference in localStorage
              localStorage.setItem('taopedia-width', this.value);
            }
          });
        });
        
        // Load saved preferences
        const savedTextSize = localStorage.getItem('taopedia-text-size');
        if (savedTextSize) {
          const savedRadio = document.querySelector(`input[name="ap-text"][value="${savedTextSize}"]`);
          if (savedRadio) {
            savedRadio.checked = true;
            articleBody.classList.remove('text-small', 'text-standard', 'text-large');
            articleBody.classList.add('text-' + savedTextSize);
          }
        }
        
        const savedWidth = localStorage.getItem('taopedia-width');
        if (savedWidth) {
          const savedRadio = document.querySelector(`input[name="ap-width"][value="${savedWidth}"]`);
          if (savedRadio) {
            savedRadio.checked = true;
            articleBody.classList.remove('width-narrow', 'width-standard', 'width-wide');
            articleBody.classList.add('width-' + savedWidth);
            document.body.classList.remove('content-width-narrow', 'content-width-standard', 'content-width-wide');
            document.body.classList.add('content-width-' + savedWidth);
          }
        }
      });
    </script>
  </body>
</html>
