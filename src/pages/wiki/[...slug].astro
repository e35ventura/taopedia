---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { getRelatedPages, type SlugMap, type Backlinks, type LinkGraph } from '../../lib/related';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    const slug = page.id.replace(/\/index\.(md|mdx)$/, '').replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { page, slug },
    };
  });
}

const { page, slug } = Astro.props;
const { Content, headings } = await render(page);

// Try to load per-article infobox.json if present
const infoboxModules = import.meta.glob('../../content/pages/**/infobox.json', { eager: true }) as Record<string, any>;
let infobox: any = null;
for (const [p, mod] of Object.entries(infoboxModules)) {
  if (p.endsWith(`/${slug}/infobox.json`)) {
    infobox = (mod && (mod.default ?? mod)) as any;
    break;
  }
}

// Compose a unified infobox object, preferring frontmatter over per-folder JSON
const ib = {
  title: page.data.infoboxTitle ?? infobox?.title,
  image: page.data.coverImage ?? page.data.infoboxImage ?? infobox?.image,
  caption: page.data.infoboxCaption ?? infobox?.caption,
  rows: page.data.infoboxRows ?? infobox?.rows,
};

// Load slug map for broken link detection
let slugMap: SlugMap = {};
try {
  const slugData = await import('../../../public/data/slugmap.json');
  slugMap = slugData.default as SlugMap;
} catch (e) {
  // Slug map not yet generated
}

// Load the link graph and backlinks to compute "Related pages".
let relatedPages: ReturnType<typeof getRelatedPages> = [];
try {
  const [backlinksData, linkGraphData] = await Promise.all([
    import('../../../public/data/backlinks.json'),
    import('../../../public/data/linkgraph.json'),
  ]);
  relatedPages = getRelatedPages(slug, {
    slugMap,
    backlinks: backlinksData.default as Backlinks,
    linkGraph: linkGraphData.default as LinkGraph,
  });
} catch (e) {
  // Link graph not yet generated (e.g. `astro dev` before a build).
}

// Some articles hand-curate a "Related articles" section in their body.
// Where an author has done so, that curated list wins — suppress the
// auto-generated block to avoid showing two competing related lists.
const hasManualRelated = headings.some((h) =>
  /^related(\s+(articles|pages))?$/i.test(h.text.trim())
);

const historyUrl = `/wiki/${slug}/history`;
---

<WikiLayout
  title={page.data.title}
  description={page.data.summary}
  image={`/og/${slug}.png`}
  type="article"
  path={`/wiki/${slug}`}
>
  {headings.length > 1 && (
    <div slot="sidebar" class="toc-sidebar">
      <div class="toc-sidebar-inner">
        <div class="toc-header">
          <div class="toc-title">Contents</div>
          <button class="toc-hide" type="button" aria-label="Hide table of contents">hide</button>
        </div>
        <ul class="toc-list">
          {headings.map((heading, index) => {
            // Check if this heading has subsections (next heading has greater depth)
            const hasSubsections = index < headings.length - 1 && headings[index + 1].depth > heading.depth;
            const isSubsection = heading.depth > 2;
            const parentLevel = heading.depth === 2 ? 0 : (heading.depth - 2) * 16;
            
            return (
              <li 
                class={`toc-level-${heading.depth}${isSubsection ? ' toc-subsection' : ''}`} 
                data-toc-level={heading.depth}
                style={`padding-left: ${parentLevel}px;`}
              >
                <div class="toc-item-wrapper">
                  {hasSubsections ? (
                    <button class="toc-toggle" aria-label="Toggle subsections" data-slug={heading.slug}>
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  ) : (
                    <span class="toc-spacer"></span>
                  )}
                  <a href={`#${heading.slug}`} class={hasSubsections ? 'has-subsections' : ''}>
                    <span class="toc-number">{index + 1}</span> {heading.text}
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
        <div class="toc-footer">
          <a href="#" class="toc-back-to-top">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 9V3M6 3L3 6M6 3L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to top
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="mw-body-content">
    <h1 class="firstHeading">{page.data.title}</h1>

    <nav class="mw-article-toolbar">
      <button class="sidebar-toggle toolbar-toggle" aria-label="Toggle navigation">☰</button>
      <a href={`/wiki/${slug}`} class="active">Article</a>
      <a href={historyUrl}>History</a>
      <a href={`/wiki/${slug}/backlinks`}>What links here</a>
      <span class="toolbar-spacer"></span>
    </nav>

    {page.data.summary && (
      <div class="mw-article-summary" style="font-style: italic; margin-bottom: 16px; color: var(--color-base-subtle);">
        {page.data.summary}
      </div>
    )}

    <div class="mw-parser-output">
      {/** Infobox (prefer per-article file) */}
      {(ib.title || ib.image || (ib.rows && ib.rows.length > 0)) && (
        <aside class="infobox">
          {ib.title && (
            <div class="infobox-title">{ib.title}</div>
          )}
          {ib.image && (
            <img class="infobox-image" src={ib.image} alt={ib.title || page.data.title} />
          )}
          {ib.caption && (
            <div style="font-size: 12px; padding: 6px 12px; color: #54595d;">{ib.caption}</div>
          )}
          {ib.rows && ib.rows.length > 0 && (
            <table class="infobox-table">
              <tbody>
                {ib.rows.map((row: { label: string; value: string }) => (
                  <tr>
                    <th>{row.label}</th>
                    <td>{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </aside>
      )}
      <Content />
    </div>

    {relatedPages.length > 0 && !hasManualRelated && (
      <section class="related-pages" aria-labelledby="related-heading">
        <h2 id="related-heading" class="related-heading">See also</h2>
        <ul class="related-list">
          {relatedPages.map((rel) => (
            <li class="related-item">
              <a href={`/wiki/${rel.slug}`} class="related-link">{rel.title}</a>
              {rel.summary && <p class="related-summary">{rel.summary}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {page.data.categories && page.data.categories.length > 0 && (
      <div class="article-topics">
        <span>Topics</span>
        {page.data.categories.map((cat: string) => (
          <a href={`/wiki/category/${cat.replace(/ /g, '_')}`}>{cat}</a>
        ))}
      </div>
    )}
  </div>
</WikiLayout>

<script is:inline>
  // Unlink wiki links that point to non-existent pages
  // slugMap is loaded on the server above; serialize it for client-side checks
  const __slugMap = /** @type {Record<string, any>} */ (JSON.parse('{JSON.stringify(slugMap)}'));
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.mw-parser-output');
    if (!container) return;
    const anchors = container.querySelectorAll('a.internal');
    anchors.forEach((a) => {
      const href = a.getAttribute('href') || '';
      // Expect /wiki/<slug>
      const m = href.match(/^\/wiki\/(.+)$/);
      const slug = m ? m[1] : null;
      const isMissing = !slug || !Object.prototype.hasOwnProperty.call(__slugMap, slug);
      if (isMissing) {
        const span = document.createElement('span');
        span.textContent = a.textContent || '';
        a.replaceWith(span);
      }
    });
  });
</script>
