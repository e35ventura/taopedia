---
import { getCollection } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    // Remove /index.md or /index.mdx from the slug
    const slug = page.id.replace(/\/index\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { page, slug },
    };
  });
}

const { page, slug } = Astro.props;
const { Content, headings } = await page.render();

// Try to load per-article infobox.json if present
const infoboxModules = import.meta.glob('../../content/pages/**/infobox.json', { eager: true }) as Record<string, any>;
let infobox: any = null;
for (const [p, mod] of Object.entries(infoboxModules)) {
  if (p.endsWith(`/${slug}/infobox.json`)) {
    infobox = (mod && (mod.default ?? mod)) as any;
    break;
  }
}

// Compose a unified infobox object, preferring frontmatter over per-folder JSON
const ib = {
  title: page.data.infoboxTitle ?? infobox?.title,
  image: page.data.coverImage ?? page.data.infoboxImage ?? infobox?.image,
  caption: page.data.infoboxCaption ?? infobox?.caption,
  rows: page.data.infoboxRows ?? infobox?.rows,
};

// Load backlinks data
let backlinks = [];
try {
  const backlinkData = await import('../../../public/data/backlinks.json');
  backlinks = backlinkData.default[slug] || [];
} catch (e) {
  // Backlinks not yet generated
}

// Load slug map for broken link detection
let slugMap = {};
try {
  const slugData = await import('../../../public/data/slugmap.json');
  slugMap = slugData.default;
} catch (e) {
  // Slug map not yet generated
}
const ext = page.id.endsWith('.mdx') ? 'mdx' : 'md';
const editUrl = `https://github.com/grant/taopedia/edit/main/src/content/pages/${slug}/index.${ext}`;
const historyUrl = `/wiki/${slug}/history`;
---

<WikiLayout title={page.data.title} description={page.data.summary}>
  {headings.length > 1 && (
    <div slot="sidebar" class="toc-sidebar">
      <div class="toc-sidebar-inner">
        <div class="toc-header">
          <div class="toc-title">Contents</div>
          <button class="toc-hide" type="button" aria-label="Hide table of contents">hide</button>
        </div>
        <ul class="toc-list">
          {headings.map((heading, index) => {
            // Check if this heading has subsections (next heading has greater depth)
            const hasSubsections = index < headings.length - 1 && headings[index + 1].depth > heading.depth;
            const isSubsection = heading.depth > 2;
            const parentLevel = heading.depth === 2 ? 0 : (heading.depth - 2) * 16;
            
            return (
              <li 
                class={`toc-level-${heading.depth}${isSubsection ? ' toc-subsection' : ''}`} 
                data-toc-level={heading.depth}
                style={`padding-left: ${parentLevel}px;`}
              >
                <div class="toc-item-wrapper">
                  {hasSubsections ? (
                    <button class="toc-toggle" aria-label="Toggle subsections" data-slug={heading.slug}>
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  ) : (
                    <span class="toc-spacer"></span>
                  )}
                  <a href={`#${heading.slug}`} class={hasSubsections ? 'has-subsections' : ''}>
                    <span class="toc-number">{index + 1}</span> {heading.text}
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
        <div class="toc-footer">
          <a href="#" class="toc-back-to-top">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 9V3M6 3L3 6M6 3L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to top
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="mw-body-content">
    <h1 class="firstHeading">{page.data.title}</h1>

    <nav class="mw-article-toolbar">
      <button class="sidebar-toggle toolbar-toggle" aria-label="Toggle navigation">☰</button>
      <a href={`/wiki/${slug}`} class="active">Article</a>
      <a href={historyUrl}>History</a>
      <a href={editUrl} target="_blank">Edit</a>
      <a href={`/wiki/${slug}/backlinks`}>What links here</a>
      <span class="toolbar-spacer"></span>
      <button class="right-rail-toggle toolbar-toggle" aria-label="Toggle appearance settings">⚙</button>
    </nav>

    {page.data.summary && (
      <div class="mw-article-summary" style="font-style: italic; margin-bottom: 16px; color: var(--color-base-subtle);">
        {page.data.summary}
      </div>
    )}

    <div class="mw-parser-output">
      {/** Infobox (prefer per-article file) */}
      {(ib.title || ib.image || (ib.rows && ib.rows.length > 0)) && (
        <aside class="infobox">
          {ib.title && (
            <div class="infobox-title">{ib.title}</div>
          )}
          {ib.image && (
            <img class="infobox-image" src={ib.image} alt={ib.title || page.data.title} />
          )}
          {ib.caption && (
            <div style="font-size: 12px; padding: 6px 12px; color: #54595d;">{ib.caption}</div>
          )}
          {ib.rows && ib.rows.length > 0 && (
            <table class="infobox-table">
              <tbody>
                {ib.rows.map((row: { label: string; value: string }) => (
                  <tr>
                    <th>{row.label}</th>
                    <td set:html={row.value} />
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </aside>
      )}
      <Content />
    </div>

    {page.data.categories && page.data.categories.length > 0 && (
      <div style="margin-top: 24px;">
        <div style="font-weight: 600; margin-bottom: 8px;">Categories</div>
        <div class="categories-grid">
          {page.data.categories.map((cat: string) => (
            <div class="category-item">
              <a href={`/wiki/Category/${cat.replace(/ /g, '_')}`}>{cat}</a>
            </div>
          ))}
        </div>
      </div>
    )}

    {backlinks.length > 0 && (
      <details style="margin-top: 24px; padding: 12px; background: var(--background-color-interactive); border: 1px solid var(--border-color-subtle); font-size: 13px;">
        <summary style="cursor: pointer; font-weight: 600;">What links here ({backlinks.length})</summary>
        <ul style="margin: 8px 0 0 0; padding: 0 0 0 20px;">
          {backlinks.map((link: any) => (
            <li>
              <a href={`/wiki/${link.from}`}>{link.fromTitle}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</WikiLayout>

