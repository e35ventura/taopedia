---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';
import { getPageSlug } from '../../../lib/article-history';
import { compareTitles } from '../../../lib/title-sort.js';

// Short pages: published articles ranked by length (article body word count),
// shortest first. Surfaces stubs and thin entries that are the best candidates
// for expansion -- a standard wiki maintenance view (the inverse of a longest-
// pages list). Word count uses the same body-word measure as Special:Statistics
// and the per-article metadata line, so the numbers agree across the site. Ties
// break by title then slug for a deterministic order.
const pages = await getCollection('pages');
const shortPages = pages
  .map((page) => ({
    slug: getPageSlug(page),
    title: page.data.title,
    words: (page.body ?? '').trim().split(/\s+/).filter(Boolean).length,
  }))
  .sort((a, b) => a.words - b.words || compareTitles(a.title, b.title) || compareTitles(a.slug, b.slug));
---

<WikiLayout
  title="Short pages"
  description="Articles in the Taopedia Bittensor knowledge base ranked by length, shortest first -- the best candidates for expansion."
>
  <div class="mw-body-content">
    <h1 class="firstHeading">Short pages</h1>

    <div class="mw-parser-output">
      <p>
        Published articles ranked by length (article word count), shortest first. The shortest
        entries are the best candidates for expansion.
      </p>

      {shortPages.length === 0 ? (
        <p>No articles available yet.</p>
      ) : (
        <ol class="mw-shortpages">
          {shortPages.map((entry) => (
            <li class="mw-sp-row">
              <a class="mw-sp-title" href={`/wiki/${entry.slug}/`}>{entry.title}</a>
              <span class="mw-sp-count">{entry.words} {entry.words === 1 ? 'word' : 'words'}</span>
            </li>
          ))}
        </ol>
      )}
    </div>
  </div>
</WikiLayout>

<style>
  .mw-shortpages {
    margin: 16px 0;
    padding-left: 32px;
  }
  .mw-sp-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border-color-subtle);
    font-size: 14px;
  }
  .mw-sp-title {
    font-weight: 600;
  }
  .mw-sp-count {
    margin-left: auto;
    font-size: 13px;
    white-space: nowrap;
    color: var(--color-base-subtle);
  }
</style>
