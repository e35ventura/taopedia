---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';
import { getPageSlug, historyForSlug } from '../../../lib/article-history';
import { buildStatistics } from '../../../../scripts/statistics.js';
import categoriesIndex from '../../../../public/data/categories.json';

const pages = await getCollection('pages');

// Shared with statistics.json (#1414) via buildStatistics(). Topic counts come
// from public/data/categories.json — the same artifact categories.json (#1403)
// reads — instead of re-counting every article's categories frontmatter.
const stats = buildStatistics({
  pages,
  historyForSlug,
  getPageSlug,
  categoriesIndex,
});

const newestLabel = stats.newestDate
  ? new Date(stats.newestDate).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const rows: Array<{ label: string; value: string }> = [
  { label: 'Articles', value: stats.totalArticles.toLocaleString('en-US') },
  { label: 'Topics', value: stats.totalTopics.toLocaleString('en-US') },
  { label: 'Total revisions', value: stats.totalRevisions.toLocaleString('en-US') },
  { label: 'Total words', value: stats.totalWords.toLocaleString('en-US') },
  { label: 'Average words per article', value: stats.averageWords.toLocaleString('en-US') },
];
if (stats.largestTopic) {
  rows.push({
    label: 'Largest topic',
    value: `${stats.largestTopic.name} (${stats.largestTopic.count.toLocaleString('en-US')})`,
  });
}
---

<WikiLayout title="Statistics" description="Content statistics for the Taopedia Bittensor knowledge base.">
  <div class="mw-body-content">
    <h1 class="firstHeading">Statistics</h1>

    <div class="mw-parser-output">
      <p>An overview of the Taopedia Bittensor knowledge base.</p>

      <dl class="mw-statistics">
        {rows.map((stat) => (
          <div class="mw-statistics-row">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
        {newestLabel && (
          <div class="mw-statistics-row">
            <dt>Most recently updated</dt>
            <dd><time datetime={stats.newestDate}>{newestLabel}</time> (UTC)</dd>
          </div>
        )}
      </dl>
    </div>
  </div>
</WikiLayout>

<style>
  .mw-statistics {
    margin: 16px 0;
  }
  .mw-statistics-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border-color-subtle);
  }
  .mw-statistics dt {
    color: var(--color-base-subtle);
  }
  .mw-statistics dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
</style>
