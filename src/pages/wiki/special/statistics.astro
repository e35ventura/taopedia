---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';
import { getPageSlug, historyForSlug } from '../../../lib/article-history';
import { buildStatistics } from '../../../../scripts/statistics.js';
import categoriesIndex from '../../../../public/data/categories.json';

const pages = await getCollection('pages');

// Aggregate word counts and revision history from the content collection, with
// topic counts from public/data/categories.json — the same artifact
// statistics.json (#1404) and categories.json (#1403) read — via the shared
// buildStatistics() helper so the HTML and JSON surfaces never disagree.
const {
  totalArticles,
  totalTopics,
  totalRevisions,
  totalWords,
  averageWords,
  newestDate,
  largestTopic,
} = buildStatistics({ pages, historyForSlug, getPageSlug, categoriesIndex });

const newestLabel = newestDate
  ? new Date(newestDate).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const stats: Array<{ label: string; value: string }> = [
  { label: 'Articles', value: totalArticles.toLocaleString('en-US') },
  { label: 'Topics', value: totalTopics.toLocaleString('en-US') },
  { label: 'Total revisions', value: totalRevisions.toLocaleString('en-US') },
  { label: 'Total words', value: totalWords.toLocaleString('en-US') },
  { label: 'Average words per article', value: averageWords.toLocaleString('en-US') },
];
if (largestTopic) {
  stats.push({ label: 'Largest topic', value: `${largestTopic.name} (${largestTopic.count.toLocaleString('en-US')})` });
}
---

<WikiLayout title="Statistics" description="Content statistics for the Taopedia Bittensor knowledge base.">
  <div class="mw-body-content">
    <h1 class="firstHeading">Statistics</h1>

    <div class="mw-parser-output">
      <p>An overview of the Taopedia Bittensor knowledge base.</p>

      <dl class="mw-statistics">
        {stats.map((stat) => (
          <div class="mw-statistics-row">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
        {newestLabel && (
          <div class="mw-statistics-row">
            <dt>Most recently updated</dt>
            <dd><time datetime={newestDate}>{newestLabel}</time> (UTC)</dd>
          </div>
        )}
      </dl>
    </div>
  </div>
</WikiLayout>

<style>
  .mw-statistics {
    margin: 16px 0;
  }
  .mw-statistics-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border-color-subtle);
  }
  .mw-statistics dt {
    color: var(--color-base-subtle);
  }
  .mw-statistics dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
</style>
