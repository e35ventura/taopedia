---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import type { BacklinksMap } from '../../../lib/linkgraph';

const backlinksModules = import.meta.glob('../../../../public/data/backlinks.json', { eager: true }) as Record<string, { default: BacklinksMap }>;
const backlinksData: BacklinksMap = Object.values(backlinksModules)[0]?.default ?? {};

const slugmapModules = import.meta.glob('../../../../public/data/slugmap.json', { eager: true }) as Record<string, { default: Record<string, { title: string }> }>;
const slugMap = Object.values(slugmapModules)[0]?.default ?? {};

const entries = Object.entries(backlinksData)
  .map(([slug, sources]) => ({
    slug,
    title: slugMap[slug]?.title ?? slug,
    count: sources.length,
  }))
  .sort((a, b) => b.count - a.count || a.title.localeCompare(b.title));
---

<WikiLayout title="What links here — index">
  <div class="mw-body-content">
    <h1 class="firstHeading">What links here</h1>

    <p style="margin-bottom: 16px; font-size: 13px; color: var(--color-base-subtle);">
      All articles that have at least one inbound link, sorted by number of linking pages.
      Click an article to see the full list of pages that link to it.
    </p>

    {entries.length === 0 ? (
      <p>No backlink data available. Run <code>npm run build</code> to generate it.</p>
    ) : (
      <ul style="list-style: none; margin: 0; padding: 0;">
        {entries.map((entry) => (
          <li style="padding: 10px 12px; border: 1px solid var(--border-color-subtle); margin-bottom: 6px; background: var(--background-color-interactive); display: flex; justify-content: space-between; align-items: center;">
            <a href={`/wiki/${entry.slug}/backlinks`} style="font-weight: 600; color: var(--color-link); text-decoration: none;">
              {entry.title}
            </a>
            <span style="font-size: 12px; color: var(--color-base-subtle);">
              {entry.count} {entry.count === 1 ? 'link' : 'links'}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</WikiLayout>
