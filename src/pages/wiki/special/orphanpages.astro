---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import type { OrphanPage } from '../../../lib/linkgraph';

const orphanModules = import.meta.glob('../../../../public/data/orphanpages.json', { eager: true }) as Record<string, { default: OrphanPage[] }>;
const orphanPages: OrphanPage[] = Object.values(orphanModules)[0]?.default ?? [];
---

<WikiLayout title="Orphan pages">
  <div class="mw-body-content">
    <h1 class="firstHeading">Orphan pages</h1>

    <p style="margin-bottom: 16px; font-size: 13px; color: var(--color-base-subtle);">
      Articles that no other article links to. Consider linking to these from related pages.
    </p>

    {orphanPages.length === 0 ? (
      <p>No orphan pages found. Either all articles are linked, or run <code>npm run build</code> to generate this data.</p>
    ) : (
      <ul style="list-style: none; margin: 0; padding: 0;">
        {orphanPages.map((entry) => (
          <li style="padding: 10px 12px; border: 1px solid var(--border-color-subtle); margin-bottom: 6px; background: var(--background-color-interactive);">
            <a href={`/wiki/${entry.slug}`} style="font-weight: 600; color: var(--color-link); text-decoration: none;">
              {entry.title}
            </a>
            <span style="font-size: 12px; color: var(--color-base-subtle); margin-left: 8px;">
              /wiki/{entry.slug}
            </span>
          </li>
        ))}
      </ul>
    )}

    <p style="margin-top: 20px; font-size: 12px; color: var(--color-base-subtle);">
      {orphanPages.length} {orphanPages.length === 1 ? 'article has' : 'articles have'} no inbound links.
    </p>
  </div>
</WikiLayout>
