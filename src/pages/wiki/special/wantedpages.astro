---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import type { WantedPage } from '../../../lib/linkgraph';

const wantedModules = import.meta.glob('../../../../public/data/wantedpages.json', { eager: true }) as Record<string, { default: WantedPage[] }>;
const wantedPages: WantedPage[] = Object.values(wantedModules)[0]?.default ?? [];
---

<WikiLayout title="Wanted pages">
  <div class="mw-body-content">
    <h1 class="firstHeading">Wanted pages</h1>

    <p style="margin-bottom: 16px; font-size: 13px; color: var(--color-base-subtle);">
      Wiki links that point to articles that do not yet exist, sorted by number of references.
      These are candidates for new articles.
    </p>

    {wantedPages.length === 0 ? (
      <p>No wanted pages found. Either all linked articles exist, or run <code>npm run build</code> to generate this data.</p>
    ) : (
      <ul style="list-style: none; margin: 0; padding: 0;">
        {wantedPages.map((entry) => (
          <li style="padding: 10px 12px; border: 1px solid var(--border-color-subtle); margin-bottom: 6px; background: var(--background-color-interactive); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 600; color: var(--color-base);">{entry.slug}</span>
            <span style="font-size: 12px; color: var(--color-base-subtle);">
              {entry.count} {entry.count === 1 ? 'link' : 'links'}
            </span>
          </li>
        ))}
      </ul>
    )}

    <p style="margin-top: 20px; font-size: 12px; color: var(--color-base-subtle);">
      {wantedPages.length} missing {wantedPages.length === 1 ? 'article' : 'articles'} referenced across the wiki.
    </p>
  </div>
</WikiLayout>
