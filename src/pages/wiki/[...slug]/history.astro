---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    const slug = page.id.replace(/\/index\.(md|mdx)$/, '').replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { page, slug },
    };
  });
}

const { page, slug } = Astro.props;

// Load history data
let history = [];
try {
  const historyData = await import(`../../../../public/history/${slug}.json`);
  history = historyData.default.history || [];
} catch (e) {
  console.warn(`No history found for ${slug}`);
}
const articleUrl = `/wiki/${slug}`;
---

<WikiLayout title={`Revision history of "${page.data.title}"`}>
  <div class="mw-body-content">
    <nav class="mw-article-toolbar">
      <a href={articleUrl}>Article</a>
      <a href={`/wiki/${slug}/history`} class="active">History</a>
    </nav>

    <h1 class="firstHeading">Revision history of "{page.data.title}"</h1>

    <p style="margin-bottom: 16px; font-size: 13px;">
      This page shows the edit history from Git. Each revision represents a commit that modified this article.
    </p>

    {history.length === 0 ? (
      <p>No revision history available yet.</p>
    ) : (
      <ul style="list-style: none; margin: 0; padding: 0;">
        {history.map((revision: any) => (
          <li style="padding: 12px; border: 1px solid var(--border-color-subtle); margin-bottom: 8px; background: var(--background-color-interactive);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
              <strong style="font-size: 13px;">
                {new Date(revision.date).toLocaleString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric', 
                  hour: '2-digit', 
                  minute: '2-digit' 
                })}
              </strong>
              <span style="font-size: 12px; color: var(--color-base-subtle);">
                {revision.authorName}
              </span>
            </div>
            <div style="font-size: 13px; margin-bottom: 8px;">
              {revision.message || '(no message)'}
            </div>
            <div style="font-size: 12px;">
              <code style="background: var(--background-color-neutral); padding: 2px 6px; border-radius: 2px; font-size: 11px;">
                {revision.sha.substring(0, 7)}
              </code>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</WikiLayout>
