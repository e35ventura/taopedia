---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import type { Backlink } from '../../../lib/related';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    const slug = page.id.replace(/\/index\.(md|mdx)$/, '').replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { page, slug },
    };
  });
}

const { page, slug } = Astro.props;

// Load backlinks data (generated by scripts/build-linkgraph.js during prebuild).
let backlinksMap: Record<string, Backlink[]> = {};
try {
  const mod = await import('../../../../public/data/backlinks.json');
  backlinksMap = mod.default as Record<string, Backlink[]>;
} catch (e) {
  // Backlinks not yet generated (e.g. `astro dev` before a build).
}

// One entry per source page (the raw data may list a source multiple times).
const seen = new Set<string>();
const backlinks = (backlinksMap[slug] || [])
  .filter((b) => {
    if (seen.has(b.from)) return false;
    seen.add(b.from);
    return true;
  })
  .sort((a, b) => a.fromTitle.localeCompare(b.fromTitle));

const articleUrl = `/wiki/${slug}`;
const historyUrl = `/wiki/${slug}/history`;
---

<WikiLayout title={`Pages that link to "${page.data.title}"`}>
  <div class="mw-body-content">
    <nav class="mw-article-toolbar">
      <a href={articleUrl}>Article</a>
      <a href={historyUrl}>History</a>
      <a href={`${articleUrl}/backlinks`} class="active">What links here</a>
    </nav>

    <h1 class="firstHeading">Pages that link to "{page.data.title}"</h1>

    <p style="margin-bottom: 16px; font-size: 13px;">
      The following pages link to <a href={articleUrl}>{page.data.title}</a>.
    </p>

    {backlinks.length === 0 ? (
      <p>No pages link to this article yet.</p>
    ) : (
      <ul class="mw-backlinks">
        {backlinks.map((b) => (
          <li>
            <a href={`/wiki/${b.from}`}>{b.fromTitle}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</WikiLayout>
