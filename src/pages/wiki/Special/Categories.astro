---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');

// Build category index
const categoryIndex = {};
pages.forEach(page => {
  page.data.categories?.forEach(cat => {
    if (!categoryIndex[cat]) {
      categoryIndex[cat] = [];
    }
    categoryIndex[cat].push(page);
  });
});

const sortedCategories = Object.entries(categoryIndex)
  .sort(([a], [b]) => a.localeCompare(b));
---

<WikiLayout title="Categories">
  <div slot="sidebar" class="toc-sidebar">
    <div class="toc-sidebar-inner">
      <div class="toc-header">
        <div class="toc-title">Navigation</div>
        <button class="toc-hide" type="button" aria-label="Hide navigation">hide</button>
      </div>
      <ul class="toc-list">
        <li class="toc-level-2" data-toc-level="2" style="padding-left: 0px;">
          <div class="toc-item-wrapper">
            <span class="toc-spacer"></span>
            <a href="#categories" class="">
              <span class="toc-number">1</span> Categories
            </a>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="mw-body-content">
    <nav class="mw-article-toolbar">
      <a href="#" class="active">Special page</a>
      <span class="toolbar-spacer"></span>
      <button class="sidebar-toggle toolbar-toggle" aria-label="Toggle navigation">☰</button>
      <button class="right-rail-toggle toolbar-toggle" aria-label="Toggle appearance settings">⚙</button>
    </nav>

    <h1 class="firstHeading">Categories</h1>
    
    <div class="mw-parser-output">
      <p>This special page shows all categories in Taopedia.</p>
      
      <div class="categories-list">
        <h2 id="categories">All Categories ({sortedCategories.length})</h2>
        <ul>
          {sortedCategories.map(([categoryName, categoryPages]) => (
            <li>
              <a href={`/wiki/Category/${categoryName.replace(/ /g, '_')}`}>
                {categoryName}
              </a>
              <span class="category-count">
                ({categoryPages.length} page{categoryPages.length !== 1 ? 's' : ''})
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</WikiLayout>

<style>
  .categories-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: 24px;
  }
  
  .categories-list li {
    margin: 8px 0;
    break-inside: avoid;
    padding: 8px;
    background: var(--background-color-interactive);
    border-radius: 4px;
  }
  
  .categories-list a {
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
  }
  
  .categories-list a:hover {
    text-decoration: underline;
  }
  
  .category-count {
    color: var(--color-base-subtle);
    font-size: 13px;
    margin-left: 8px;
  }
  
  @media (max-width: 900px) {
    .categories-list ul {
      columns: 2;
    }
  }
  
  @media (max-width: 600px) {
    .categories-list ul {
      columns: 1;
    }
  }
</style>
