---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');
const sortedPages = pages.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<WikiLayout title="All pages">
  <div class="mw-body-content">
    <div class="mw-article-toolbar">
      <a href="#" class="active">Special page</a>
    </div>

    <h1 class="firstHeading">All pages</h1>
    
    <div class="mw-parser-output">
      <p>This special page shows all pages in Taopedia.</p>
      
      <div class="all-pages">
        <h2>Articles ({sortedPages.length})</h2>
        <ul>
          {sortedPages.map(page => (
            <li>
              <a href={`/wiki/${page.slug}`}>{page.data.title}</a>
              {page.data.summary && (
                <span class="page-summary"> – {page.data.summary}</span>
              )}
              {page.data.categories && page.data.categories.length > 0 && (
                <div class="page-categories">
                  Categories: {page.data.categories.map((cat, index) => (
                    <>
                      <a href={`/wiki/Category/${cat.replace(/ /g, '_')}`}>{cat}</a>
                      {index < page.data.categories.length - 1 && ', '}
                    </>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</WikiLayout>

<style>
  .all-pages ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .all-pages li {
    margin: 12px 0;
    padding: 12px;
    background: var(--background-color-interactive);
    border-radius: 4px;
    border-left: 3px solid var(--color-link);
  }
  
  .all-pages li > a {
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
    font-size: 16px;
  }
  
  .all-pages li > a:hover {
    text-decoration: underline;
  }
  
  .page-summary {
    color: var(--color-base-subtle);
    font-size: 14px;
    display: block;
    margin-top: 4px;
  }
  
  .page-categories {
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-base-subtle);
  }
  
  .page-categories a {
    color: var(--color-link);
    text-decoration: none;
    font-size: 12px;
  }
  
  .page-categories a:hover {
    text-decoration: underline;
  }
</style>
