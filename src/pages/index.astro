---
import '../styles/wikipedia.css';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');

// Load categories
let categoryIndex = {};
try {
  const categoryData = await import('../../public/data/categories.json');
  categoryIndex = categoryData.default;
} catch (e) {
  // Categories not yet generated
}

// Get top categories for the circular portal and full list for the grid
const topCategories = Object.entries(categoryIndex)
  .sort((a: any, b: any) => b[1].length - a[1].length)
  .slice(0, 12);

const allCategories = Object.entries(categoryIndex)
  .sort((a: any, b: any) => b[1].length - a[1].length);

// Get a random featured article
const featuredPage = pages[Math.floor(Math.random() * pages.length)];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Taopedia - The Free Encyclopedia</title>
    <meta name="description" content="The Free Encyclopedia" />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: var(--font-family-sans);
        background: #f8f9fa;
      }
      
      .portal-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 32px 24px 64px;
      }

      /* Circle layout section */
      .portal-circle-section {
        margin-bottom: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .portal-circle-wrapper {
        position: relative;
        width: 600px;
        height: 600px;
        transform: scale(var(--scale, 0.85));
        transform-origin: center;
      }

      .portal-globe {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        height: 200px;
        background: transparent;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
      }

      .portal-globe img {
        width: 80px;
        height: auto;
        filter: brightness(0);
        position: relative;
        z-index: 2;
      }

      .portal-aura-canvas {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
        z-index: 0;
      }

      .portal-lang-link {
        position: absolute;
        text-align: center;
        width: 140px;
        z-index: 10;
      }

      .portal-lang-link a {
        color: #3366cc;
        text-decoration: none;
        font-size: 16px;
        font-weight: 600;
        display: block;
        margin-bottom: 2px;
      }

      .portal-lang-link a:hover {
        text-decoration: underline;
      }

      .portal-lang-count {
        font-size: 13px;
        color: #54595d;
      }
      
      /* Header */
      .portal-header {
        text-align: center;
        margin-bottom: 32px;
        padding: 24px 0;
      }

      .portal-logo {
        font-family: 'Linux Libertine', 'Georgia', 'Times', 'Source Serif Pro', serif;
        font-size: 2.5em;
        font-weight: 400;
        color: #000;
        text-decoration: none;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        line-height: 1.2;
      }

      .portal-logo img {
        width: 60px;
        height: auto;
      }

      /* Match header style for larger T and A letters */
      .logo-letter-large {
        font-size: 1.2em;
        font-weight: 500;
      }

      .portal-tagline {
        font-size: 16px;
        color: #54595d;
        margin-top: 4px;
      }
      
      /* Search */
      .portal-search {
        max-width: 600px;
        margin: 0 auto 48px;
      }

      .portal-search form {
        display: flex;
        border: 1px solid #a2a9b1;
        background: white;
      }

      .portal-search input {
        flex: 1;
        padding: 14px 16px;
        border: none;
        font-size: 16px;
        font-family: var(--font-family-sans);
      }

      .portal-search input:focus {
        outline: none;
      }

      .portal-search button {
        padding: 14px 28px;
        background: #3366cc;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: background 0.2s;
      }

      .portal-search button:hover {
        background: #2952a3;
      }

      /* Main content grid */
      .portal-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 48px;
      }

      .portal-section {
        background: white;
        border: 1px solid #a2a9b1;
        padding: 20px 24px;
      }

      .portal-section h2 {
        font-family: var(--font-family-serif);
        font-size: 20px;
        font-weight: 400;
        margin: 0 0 16px 0;
        padding-bottom: 12px;
        border-bottom: 1px solid #a2a9b1;
        color: #000;
      }

      /* Categories grid */
      .categories-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .category-item {
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 2px;
        transition: background 0.2s;
      }

      .category-item:hover {
        background: #eaecf0;
      }

      .category-item a {
        color: #3366cc;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        display: block;
        margin-bottom: 2px;
      }

      .category-item a:hover {
        text-decoration: underline;
      }

      .category-count {
        font-size: 12px;
        color: #54595d;
      }

      /* Featured article */
      .featured-article {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .featured-article h3 {
        margin: 0;
        font-size: 18px;
      }

      .featured-article h3 a {
        color: #3366cc;
        text-decoration: none;
      }

      .featured-article h3 a:hover {
        text-decoration: underline;
      }

      .featured-article p {
        margin: 0;
        color: #202122;
        line-height: 1.6;
        font-size: 14px;
      }

      .featured-article .read-more {
        color: #3366cc;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }

      /* Quick links */
      .quick-links {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .quick-links li {
        margin-bottom: 8px;
      }

      .quick-links a {
        color: #3366cc;
        text-decoration: none;
        font-size: 15px;
      }

      .quick-links a:hover {
        text-decoration: underline;
      }

      /* Stats */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }

      .stat-item {
        text-align: center;
        padding: 16px;
        background: #f8f9fa;
        border-radius: 2px;
      }

      .stat-number {
        font-size: 32px;
        font-weight: 600;
        color: #3366cc;
        font-family: var(--font-family-serif);
      }

      .stat-label {
        font-size: 13px;
        color: #54595d;
        margin-top: 4px;
      }
      
      
      /* Footer */
      .portal-footer {
        text-align: center;
        padding-top: 32px;
        border-top: 1px solid #a2a9b1;
        font-size: 13px;
        color: #54595d;
      }

      .portal-footer a {
        color: #3366cc;
        text-decoration: none;
        margin: 0 12px;
      }

      .portal-footer a:hover {
        text-decoration: underline;
      }
      

      /* Responsive */
      @media (max-width: 768px) {
        .portal-container {
          padding: 24px 16px 48px;
        }

        .portal-circle-wrapper {
          transform: scale(0.6);
        }

        .portal-circle-section {
          margin-bottom: 24px;
        }

        .portal-logo {
          font-size: 36px;
        }

        .portal-logo img {
          width: 48px;
        }

        .portal-content {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .categories-grid {
          grid-template-columns: 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr;
        }

        .portal-search {
          margin-bottom: 32px;
        }

        .portal-search input {
          padding: 12px 14px;
          font-size: 15px;
        }

        .portal-search button {
          padding: 12px 20px;
        }

        .portal-section {
          padding: 16px 18px;
        }

        .portal-footer a {
          display: block;
          margin: 8px 0;
        }
      }

      @media (max-width: 480px) {
        .portal-circle-wrapper {
          transform: scale(0.5);
        }

        .portal-lang-link {
          width: 100px;
        }

        .portal-lang-link a {
          font-size: 14px;
        }

        .portal-lang-count {
          font-size: 11px;
        }

        .portal-logo {
          font-size: 28px;
          flex-direction: column;
          gap: 4px;
        }

        .portal-logo img {
          width: 40px;
        }

        .portal-tagline {
          font-size: 14px;
        }

        .portal-section h2 {
          font-size: 18px;
        }

        .stat-number {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class="portal-container">
      <!-- Header -->
      <div class="portal-header">
        <a href="/" class="portal-logo">
          <span class="portal-logo-text">
            <span class="logo-letter-large">T</span>AOPEDI<span class="logo-letter-large">A</span>
          </span>
        </a>
        <div class="portal-tagline">The Free Encyclopedia</div>
      </div>

      <!-- Circular category layout -->
      <div class="portal-circle-section">
        <div class="portal-circle-wrapper">
          <!-- Center logo -->
          <div class="portal-globe">
            <canvas class="portal-aura-canvas" width="550" height="550"></canvas>
            <img src="/logo.svg" alt="Taopedia logo" />
          </div>
          
          <!-- Categories arranged in a circle -->
          {topCategories.slice(0, 10).map(([cat, articles]: [string, any], index: number) => {
            const angle = (index * 360 / 10) - 90; // Start from top
            const radius = 250;
            const x = 300 + radius * Math.cos(angle * Math.PI / 180);
            const y = 300 + radius * Math.sin(angle * Math.PI / 180);
            
            return (
              <div 
                class="portal-lang-link" 
                style={`left: ${x - 70}px; top: ${y - 30}px;`}
              >
                <a href={`/wiki/Category/${cat.replace(/ /g, '_')}`}>{cat}</a>
                <div class="portal-lang-count">{articles.length} article{articles.length !== 1 ? 's' : ''}</div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Search -->
      <div class="portal-search">
        <form action="/search" method="get">
          <input 
            type="search" 
            name="q" 
            placeholder="Search Taopedia..."
            aria-label="Search"
          />
          <button type="submit">Search</button>
        </form>
      </div>

      <!-- Main content grid -->
      <div class="portal-content">
        <!-- Browse by category -->
        <div class="portal-section">
          <h2>Browse by Category</h2>
          <div class="categories-grid">
            {allCategories.map(([cat, articles]: [string, any]) => (
              <div class="category-item">
                <a href={`/wiki/Category/${cat.replace(/ /g, '_')}`}>{cat}</a>
                <div class="category-count">{articles.length} article{articles.length !== 1 ? 's' : ''}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Featured article -->
        {featuredPage && (
          <div class="portal-section">
            <h2>Featured Article</h2>
            <div class="featured-article">
              <h3><a href={`/wiki/${featuredPage.slug}`}>{featuredPage.data.title}</a></h3>
              {featuredPage.data.summary && (
                <p>{featuredPage.data.summary}</p>
              )}
              <a href={`/wiki/${featuredPage.slug}`} class="read-more">Read more →</a>
            </div>
          </div>
        )}

        <!-- Quick links -->
        <div class="portal-section">
          <h2>Quick Links</h2>
          <ul class="quick-links">
            <li><a href="/wiki/Special:AllPages">All articles</a></li>
            <li><a href="/wiki/Special:Categories">All categories</a></li>
            <li><a href="/search">Search</a></li>
            <li><a href="/wiki/Taopedia:About">About Taopedia</a></li>
            <li><a href="https://github.com/grant/taopedia" target="_blank">Contribute on GitHub</a></li>
          </ul>
        </div>

        <!-- Stats -->
        <div class="portal-section">
          <h2>Statistics</h2>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-number">{pages.length.toLocaleString()}</div>
              <div class="stat-label">Articles</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">{Object.keys(categoryIndex).length}</div>
              <div class="stat-label">Categories</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="portal-footer">
        <div>
          <a href="/wiki/Taopedia:About">About</a>
          <a href="/wiki/Taopedia:Privacy">Privacy</a>
          <a href="https://github.com/grant/taopedia" target="_blank">Contribute</a>
        </div>
        <div style="margin-top: 16px; font-size: 12px;">
          Made possible by gittensor
        </div>
      </div>
    </div>

    <script>
      // Particle-based aura animation with ultra-smooth gradient effect
      const canvas = document.querySelector('.portal-aura-canvas');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        const centerX = canvas.width / 2;
        const centerY = canvas.height / 2;
        const maxRadius = canvas.width / 2;
        
        // Particle system - many more particles for ultra-smooth gradient
        const particles = [];
        const particleCount = 15000;
        
        // Create particles with randomized properties
        for (let i = 0; i < particleCount; i++) {
          const angle = Math.random() * Math.PI * 2;
          const distance = Math.random() * maxRadius;
          
          particles.push({
            x: centerX + Math.cos(angle) * distance,
            y: centerY + Math.sin(angle) * distance,
            baseDistance: distance,
            angle: angle,
            rotationSpeed: 0.0002 + Math.random() * 0.0008,
            flickerSpeed: 0.003 + Math.random() * 0.01,
            flickerOffset: Math.random() * Math.PI * 2,
            baseSize: 0.6 + Math.random() * 1.2,
            // Random wandering motion
            wanderAngle: Math.random() * Math.PI * 2,
            wanderSpeed: 0.01 + Math.random() * 0.02,
            wanderRadius: 2 + Math.random() * 4,
            // Random size pulsation
            sizePhase: Math.random() * Math.PI * 2,
            sizeSpeed: 0.005 + Math.random() * 0.015,
            sizeVariation: 0.3 + Math.random() * 0.5,
          });
        }
        
        let frame = 0;
        
        // Simple noise function for irregular edges
        function noise(angle, time) {
          return Math.sin(angle * 3 + time * 0.001) * 0.075 +
                 Math.sin(angle * 5 - time * 0.0015) * 0.05 +
                 Math.sin(angle * 8 + time * 0.002) * 0.025;
        }
        
        function animate() {
          // Clear canvas with very subtle fade for ultra-smooth trails
          ctx.fillStyle = 'rgba(248, 249, 250, 0.08)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          
          frame++;
          
          // Stronger blur for smoother gradient
          ctx.filter = 'blur(2.5px)';
          
          // Draw particles
          particles.forEach(particle => {
            // Rotate particle around center
            particle.angle += particle.rotationSpeed;
            const baseX = centerX + Math.cos(particle.angle) * particle.baseDistance;
            const baseY = centerY + Math.sin(particle.angle) * particle.baseDistance;
            
            // Add random wandering/sliding motion
            particle.wanderAngle += particle.wanderSpeed;
            const wanderX = Math.cos(particle.wanderAngle) * particle.wanderRadius;
            const wanderY = Math.sin(particle.wanderAngle) * particle.wanderRadius;
            
            // Final position with wander offset
            particle.x = baseX + wanderX;
            particle.y = baseY + wanderY;
            
            // Calculate irregular edge boundary
            const edgeNoise = noise(particle.angle, frame);
            const irregularMaxRadius = maxRadius * (1 + edgeNoise);
            const distanceRatio = particle.baseDistance / irregularMaxRadius;
            const centerProbability = Math.max(0, Math.min(1, 1 - distanceRatio));
            
            // Very smooth flickering effect
            const flicker = Math.sin(frame * particle.flickerSpeed + particle.flickerOffset) * 0.2 + 0.8;
            
            // Very gentle random visibility culling
            const visibilityCheck = Math.random();
            const visibilityThreshold = Math.pow(centerProbability, 0.4) * 0.95;
            if (visibilityCheck > visibilityThreshold) {
              return;
            }
            
            // Ultra-smooth opacity gradient: gentler falloff
            const baseOpacity = Math.pow(centerProbability, 1.2);
            const opacity = baseOpacity * flicker * (0.6 + Math.random() * 0.2);
            
            // Calculate pulsating size
            const sizePulse = Math.sin(frame * particle.sizeSpeed + particle.sizePhase);
            const currentSize = particle.baseSize * (1 + sizePulse * particle.sizeVariation);
            
            // Wikipedia blue color with smooth gradient opacity
            ctx.fillStyle = `rgba(51, 102, 204, ${opacity})`;
            ctx.beginPath();
            ctx.arc(particle.x, particle.y, currentSize, 0, Math.PI * 2);
            ctx.fill();
          });
          
          // Reset filter
          ctx.filter = 'none';
          
          // Continue animation if user doesn't prefer reduced motion
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            requestAnimationFrame(animate);
          }
        }
        
        // Start animation
        animate();
      }
    </script>
  </body>
</html>
