---
import '../styles/wikipedia.css';
import { getCollection } from 'astro:content';
import Seo from '../components/Seo.astro';
import { sortPagesByTitle } from '../lib/title-sort.js';
import trendingPages from '../data/trending-pages.json';

const pages = await getCollection('pages');
const sortedPages = sortPagesByTitle(pages);
const getPageSlug = (page: { id: string }) =>
  page.id.replace(/\/index\.(md|mdx)$/, '').replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');

const categoryIndex = new Map<string, typeof pages>();
for (const page of pages) {
  for (const category of page.data.categories ?? []) {
    const existing = categoryIndex.get(category) ?? [];
    existing.push(page);
    categoryIndex.set(category, existing);
  }
}

const priorityCategories = ['Wallets', 'Subnets', 'Mining', 'Staking', 'Consensus', 'Tokenomics'];
const topicCategories = priorityCategories
  .map((name) => [name, categoryIndex.get(name)] as const)
  .filter((entry): entry is readonly [string, typeof pages] => Boolean(entry[1]));

const featuredSlugs = [
  'dynamic_tao',
  'yuma_consensus',
  'wallets_coldkey_hotkey',
  'mining_and_validating',
];
const featuredPages = featuredSlugs
  .map((slug) => pages.find((page) => getPageSlug(page) === slug))
  .filter(Boolean);
const pageBySlug = new Map(pages.map((page) => [getPageSlug(page), page]));
const trendingEntry = trendingPages.entries.find((entry) => pageBySlug.has(entry.slug));
const trendingArticle = trendingEntry ? pageBySlug.get(trendingEntry.slug) : undefined;
const featuredArticle = trendingArticle
  ?? sortedPages.find((page) => page.data.featured)
  ?? featuredPages[0]
  ?? sortedPages[0];
const featuredArticleSlug = featuredArticle ? getPageSlug(featuredArticle) : '';
const featuredKicker = trendingArticle ? 'Most Read Article' : 'Featured Article';

const alphaGroups = new Map<string, typeof pages>();
for (const page of sortedPages) {
  const firstLetter = page.data.title.trim().charAt(0).toUpperCase();
  const group = /^[A-Z]$/.test(firstLetter) ? firstLetter : '#';
  const existing = alphaGroups.get(group) ?? [];
  existing.push(page);
  alphaGroups.set(group, existing);
}

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').filter((letter) => alphaGroups.has(letter));
const groupedPages = [...alphaGroups.entries()].sort(([a], [b]) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

const initialLetter = alphabet[0] ?? '#';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title="Bittensor Knowledge Base"
      description="A Bittensor-focused knowledge base for TAO, subnets, wallets, staking, mining, validation, and consensus."
      image="/og/home.png"
      path="/"
    />
    <style>
      body {
        margin: 0;
        font-family: var(--font-family-sans);
        color: var(--color-base);
        background: var(--background-color-base);
      }

      .home-shell {
        max-width: 1080px;
        margin: 0 auto;
        padding: 28px 31px 56px;
      }

      .home-header {
        text-align: center;
      }

      .home-brand {
        display: block;
        color: var(--color-base);
        text-decoration: none;
      }

      .brand-kicker {
        display: block;
        margin-bottom: 13px;
        color: #6b6f75;
        font-size: 11px;
        letter-spacing: 4px;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .brand-rule {
        display: block;
        border-top: 1px solid var(--color-base);
      }

      .brand-word {
        display: block;
        margin: 10px 0 12px;
        font-family: var(--font-family-serif);
        font-size: clamp(52px, 7vw, 74px);
        line-height: 1;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .brand-letter-large {
        font-size: 1.2em;
        font-weight: 500;
      }

      .brand-subtitle {
        display: block;
        margin-top: 11px;
        color: var(--color-base-subtle);
        font-size: 12px;
      }

      .home-nav {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 18px;
        margin-top: 12px;
        font-size: 12px;
      }

      .home-nav a {
        color: var(--color-base);
        text-decoration: none;
      }

      .home-nav a:hover {
        color: var(--color-link);
        text-decoration: underline;
      }

      .home-hero {
        display: flex;
        justify-content: center;
        padding: 16px 0 20px;
        border-bottom: 1px solid var(--border-color-subtle);
        text-align: center;
      }

      h1 {
        margin: 0;
        max-width: 700px;
        font-family: var(--font-family-serif);
        font-size: 44px;
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: 0;
      }

      .home-intro {
        max-width: 650px;
        margin: 14px 0 0;
        color: var(--color-base-subtle);
        font-size: 16px;
        line-height: 1.6;
      }

      .home-search {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        width: min(560px, 100%);
        margin: 0 auto;
        border: 1px solid var(--border-color-base);
        background: var(--background-color-base);
        text-align: left;
      }

      .home-search-icon {
        width: 18px;
        height: 18px;
        margin-left: 14px;
        color: var(--color-base-subtle);
      }

      .home-search input {
        min-width: 0;
        width: 100%;
        padding: 12px 12px;
        border: 0;
        font: inherit;
        font-size: 15px;
        outline: none;
      }

      .home-search:focus-within {
        border-color: var(--color-link);
        box-shadow: inset 0 0 0 1px var(--color-link);
      }

      .home-search button {
        align-self: stretch;
        min-width: 83px;
        padding: 0 20px;
        border: 0;
        border-left: 1px solid var(--border-color-base);
        background: var(--color-link);
        color: white;
        font-weight: 700;
        cursor: pointer;
      }

      .home-search button:hover {
        background: #2a4b8d;
      }

      .search-suggestions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        max-width: 640px;
        margin: 12px auto 0;
      }

      .search-suggestions span {
        color: var(--color-base-subtle);
        font-size: 13px;
      }

      .search-suggestions a {
        color: var(--color-link);
        font-size: 13px;
        text-decoration: none;
      }

      .search-suggestions a:hover {
        text-decoration: underline;
      }

      .featured-article {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.95fr);
        gap: 48px;
        align-items: center;
        padding: 32px 0 50px;
        border-bottom: 1px solid var(--border-color-subtle);
      }

      .featured-kicker {
        margin: 0 0 10px;
        color: #6b6f75;
        font-size: 12px;
        letter-spacing: 4px;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .featured-title {
        margin: 0;
        font-family: var(--font-family-serif);
        font-size: 32px;
        font-weight: 400;
        line-height: 1.15;
      }

      .featured-summary {
        max-width: 650px;
        margin: 13px 0 16px;
        color: var(--color-base-subtle);
        font-size: 16px;
        line-height: 1.55;
      }

      .featured-lines {
        display: grid;
        gap: 8px;
        width: min(570px, 100%);
        margin: 0 0 24px;
      }

      .featured-lines span {
        display: block;
        height: 8px;
        border-radius: 1px;
        background: #c8ccd1;
      }

      .featured-lines span:nth-child(1) {
        width: 100%;
      }

      .featured-lines span:nth-child(2) {
        width: 94%;
      }

      .featured-lines span:nth-child(3) {
        width: 73%;
      }

      .featured-link {
        display: inline-flex;
        align-items: center;
        min-height: 34px;
        padding: 0 16px;
        background: var(--color-link);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
      }

      .featured-link:hover {
        background: #2a4b8d;
        text-decoration: none;
      }

      .featured-figure {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 190px;
        border: 1px dashed var(--border-color-base);
        background:
          repeating-linear-gradient(
            135deg,
            #f7f8fa 0,
            #f7f8fa 10px,
            #edf0f4 10px,
            #edf0f4 18px
          );
        color: var(--color-base-subtle);
        font-size: 12px;
      }

      .home-section {
        padding: 32px 0;
      }

      .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
      }

      .section-heading h2 {
        margin: 0;
        font-family: var(--font-family-serif);
        font-size: 28px;
        font-weight: 400;
      }

      .section-heading a {
        color: var(--color-link);
        font-size: 13px;
        text-decoration: none;
      }

      .topic-grid,
      .article-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .topic-link,
      .article-card {
        display: block;
        min-height: 100%;
        padding: 14px;
        border: 1px solid var(--border-color-subtle);
        background: var(--background-color-interactive);
        color: var(--color-base);
        text-decoration: none;
      }

      .topic-link:hover,
      .article-card:hover {
        border-color: var(--color-link);
        text-decoration: none;
      }

      .topic-link strong,
      .article-card strong {
        display: block;
        color: var(--color-link);
        font-size: 15px;
      }

      .topic-link span,
      .article-card span {
        display: block;
        margin-top: 6px;
        color: var(--color-base-subtle);
        font-size: 13px;
        line-height: 1.45;
      }

      .term-panel {
        padding-top: 4px;
      }

      .term-group ul {
        columns: 3;
        column-gap: 32px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .term-group li {
        break-inside: avoid;
        margin: 0 0 9px;
        line-height: 1.3;
      }

      .term-group a {
        color: var(--color-link);
        text-decoration: none;
      }

      .term-group a:hover {
        text-decoration: underline;
      }

      .more-terms {
        margin-top: 18px;
      }

      .alpha-nav {
        display: grid;
        grid-template-columns: repeat(26, minmax(0, 1fr));
        gap: 4px;
      }

      .alpha-nav button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        width: 100%;
        height: 34px;
        padding: 0;
        border: 1px solid var(--border-color-base);
        background: var(--background-color-base);
        color: var(--color-link);
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }

      .alpha-nav button:hover,
      .alpha-nav button.active {
        border-color: var(--color-link);
        background: var(--background-color-interactive);
      }

      .alpha-nav button:disabled {
        border-color: var(--border-color-subtle);
        color: var(--color-base-subtle);
        cursor: not-allowed;
        opacity: 0.55;
      }

      .home-footer {
        padding-top: 24px;
        border-top: 1px solid var(--border-color-subtle);
        color: var(--color-base-subtle);
        font-size: 12px;
      }

      @media (max-width: 820px) {
        .home-nav {
          flex-wrap: wrap;
        }

        .home-hero {
          padding: 16px 0 22px;
        }

        h1 {
          font-size: 36px;
        }

        .home-search {
          grid-template-columns: auto minmax(0, 1fr);
        }

        .home-search button {
          grid-column: 1 / -1;
          padding: 12px;
          border-left: 0;
          border-top: 1px solid var(--border-color-base);
        }

        .featured-article {
          grid-template-columns: 1fr;
          gap: 24px;
          padding: 28px 0 36px;
        }

        .featured-figure {
          min-height: 170px;
        }

        .topic-grid,
        .article-grid {
          grid-template-columns: 1fr;
        }

        .term-group ul {
          columns: 1;
        }

        .alpha-nav {
          gap: 2px;
        }

        .alpha-nav button {
          height: 30px;
          font-size: 11px;
        }
      }
    </style>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>

    <main id="content" class="home-shell" tabindex="-1">
      <header class="home-header">
        <a href="/" class="home-brand" aria-label="Taopedia home">
          <span class="brand-kicker">The Bittensor Knowledge Base · Est. 2025</span>
          <span class="brand-rule" aria-hidden="true"></span>
          <span class="brand-word"><span class="brand-letter-large">T</span>AOPEDI<span class="brand-letter-large">A</span></span>
          <span class="brand-rule" aria-hidden="true"></span>
          <span class="brand-subtitle">{pages.length} reference articles · TAO · subnets · staking · consensus</span>
        </a>
        <nav class="home-nav" aria-label="Primary">
          <a href="/wiki/special/allpages">Articles</a>
          <a href="/wiki/special/categories">Topics</a>
        </nav>
      </header>

      <section class="home-hero">
        <div>
          <form class="home-search" action="/search" method="get">
            <svg class="home-search-icon" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M8.5 14.5a6 6 0 1 1 4.24-1.76l3.26 3.26-1.41 1.41-3.26-3.26A5.97 5.97 0 0 1 8.5 14.5Zm0-2a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" fill="currentColor" />
            </svg>
            <input type="search" name="q" placeholder={`Search ${pages.length} articles...`} aria-label="Search Taopedia" autocomplete="off" />
            <button type="submit">Search</button>
          </form>
          <div class="search-suggestions" aria-label="Suggested searches">
            <span>Try</span>
            <a href="/wiki/dynamic_tao">Dynamic TAO</a>
            <a href="/wiki/yuma_consensus">Yuma Consensus</a>
            <a href="/wiki/wallets_coldkey_hotkey">coldkey vs hotkey</a>
          </div>
        </div>
      </section>

      <section class="featured-article" aria-labelledby="featured-article-title">
        <div>
          <p class="featured-kicker">{featuredKicker}</p>
          <h1 id="featured-article-title" class="featured-title">{featuredArticle?.data.title ?? 'Featured Article'}</h1>
          <p class="featured-summary">
            {featuredArticle?.data.summary ?? 'A selected Taopedia reference article for the Bittensor knowledge base.'}
          </p>
          <div class="featured-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          {featuredArticleSlug && <a class="featured-link" href={`/wiki/${featuredArticleSlug}`}>Read article →</a>}
        </div>
        <div class="featured-figure" aria-label="Diagram placeholder">diagram / figure</div>
      </section>

      <section class="home-section">
        <div class="section-heading">
          <h2>Start With A Topic</h2>
          <a href="/wiki/special/categories">All topics</a>
        </div>
        <div class="topic-grid">
          {topicCategories.map(([category, categoryPages]) => (
            <a class="topic-link" href={`/wiki/category/${category.replace(/ /g, '_')}`}>
              <strong>{category}</strong>
              <span>{categoryPages.length} article{categoryPages.length !== 1 ? 's' : ''}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="home-section">
        <div class="section-heading">
          <h2>Core Articles</h2>
          <a href="/wiki/special/allpages">All articles</a>
        </div>
        <div class="article-grid">
          {featuredPages.map((page) => (
            <a class="article-card" href={`/wiki/${getPageSlug(page)}`}>
              <strong>{page.data.title}</strong>
              {page.data.summary && <span>{page.data.summary}</span>}
            </a>
          ))}
        </div>
      </section>

      <section class="home-section" id="article-index">
        <div class="section-heading">
          <h2 id="article-index-title">Articles Beginning With '{initialLetter}'</h2>
          <a href="/wiki/special/allpages">Open directory</a>
        </div>
        <div class="term-panel">
          {groupedPages.map(([letter, letterPages]) => (
            <section class="term-group" data-letter={letter} hidden={letter !== initialLetter}>
              <ul>
                {letterPages.map((page) => (
                  <li><a href={`/wiki/${getPageSlug(page)}`}>{page.data.title}</a></li>
                ))}
              </ul>
            </section>
          ))}
          <div class="more-terms">
            <nav class="alpha-nav" aria-label="Article index letters">
              {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((letter) => (
                <button
                  type="button"
                  data-index-letter={letter}
                  aria-pressed={letter === initialLetter ? 'true' : 'false'}
                  class:list={[letter === initialLetter && 'active']}
                  disabled={!alphaGroups.has(letter)}
                >
                  {letter}
                </button>
              ))}
            </nav>
          </div>
        </div>
      </section>

      <footer class="home-footer">
        Content is maintained in the Taopedia articles repository and published as a static wiki.
      </footer>
    </main>
    <script is:inline>
      const letterButtons = Array.from(document.querySelectorAll('[data-index-letter]'));
      const letterGroups = Array.from(document.querySelectorAll('[data-letter]'));
      const indexTitle = document.getElementById('article-index-title');

      function selectLetter(letter) {
        letterGroups.forEach((group) => {
          group.hidden = group.dataset.letter !== letter;
        });
        letterButtons.forEach((button) => {
          button.classList.toggle('active', button.dataset.indexLetter === letter);
          button.setAttribute('aria-pressed', button.dataset.indexLetter === letter ? 'true' : 'false');
        });
        if (indexTitle) {
          indexTitle.textContent = `Articles Beginning With '${letter}'`;
        }
      }

      letterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const letter = button.dataset.indexLetter;
          if (letter) {
            selectLetter(letter);
          }
        });
      });
    </script>
  </body>
</html>
