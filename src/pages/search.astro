---
import WikiLayout from '../layouts/WikiLayout.astro';
import { getCollection } from 'astro:content';

const searchQuery = Astro.url.searchParams.get('q') || '';
const pages = await getCollection('pages');
const getPageSlug = (page: { id: string }) =>
  page.id.replace(/\/index\.(md|mdx)$/, '').replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
const searchEntries = pages
  .map((page) => ({
    title: page.data.title,
    summary: page.data.summary ?? '',
    url: `/wiki/${getPageSlug(page)}`,
    categories: page.data.categories ?? [],
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<WikiLayout title={searchQuery ? `Search results for "${searchQuery}"` : 'Search'}>
  <div class="mw-body-content">
    <h1 class="firstHeading">{searchQuery ? 'Search results' : 'Search'}</h1>

    <div id="search-results" class="search-results">
      {searchQuery ? (
        <p class="search-status">Searching for "<strong>{searchQuery}</strong>"...</p>
      ) : (
        <p class="search-status">Use the search field in the header to find an article.</p>
      )}
    </div>
  </div>

  <script type="application/json" id="search-data" set:html={JSON.stringify(searchEntries)} />
  <script is:inline>
    const searchQuery = new URLSearchParams(window.location.search).get('q') || '';
    const resultsContainer = document.getElementById('search-results');
    const dataEl = document.getElementById('search-data');
    const entries = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

    function normalize(value) {
      return (value || '').toLowerCase();
    }

    function renderResult(entry) {
      const item = document.createElement('a');
      item.className = 'search-result-item';
      item.href = entry.url;

      const title = document.createElement('span');
      title.className = 'search-title';
      title.textContent = entry.title;
      item.appendChild(title);

      if (entry.summary) {
        const summary = document.createElement('span');
        summary.className = 'search-summary';
        summary.textContent = entry.summary;
        item.appendChild(summary);
      }

      if (entry.categories?.length) {
        const topics = document.createElement('span');
        topics.className = 'search-topics';
        entry.categories.forEach((category) => {
          const topic = document.createElement('span');
          topic.className = 'search-topic';
          topic.textContent = category;
          topics.appendChild(topic);
        });
        item.appendChild(topics);
      }

      return item;
    }

    if (searchQuery && resultsContainer) {
      const query = normalize(searchQuery);
      const matches = entries.filter((entry) => {
        const haystack = normalize(`${entry.title} ${entry.summary} ${(entry.categories || []).join(' ')}`);
        return haystack.includes(query);
      });

      resultsContainer.innerHTML = '';

      const status = document.createElement('p');
      status.className = 'search-status';
      status.textContent = matches.length
        ? `Found ${matches.length} result${matches.length === 1 ? '' : 's'} for "${searchQuery}"`
        : `No results found for "${searchQuery}"`;
      resultsContainer.appendChild(status);

      const list = document.createElement('div');
      list.className = 'search-result-list';
      matches.forEach((entry) => list.appendChild(renderResult(entry)));
      resultsContainer.appendChild(list);
    }
  </script>

  <style>
    :global(.search-results) {
      margin-top: 20px;
    }

    :global(.search-status) {
      color: var(--color-base-subtle);
      font-size: 14px;
    }

    :global(.search-result-list) {
      display: grid;
      gap: 12px;
      margin-top: 18px;
    }

    :global(.search-result-item) {
      display: block;
      padding: 14px 16px;
      border: 1px solid var(--border-color-subtle);
      background: var(--background-color-interactive);
      text-decoration: none;
      color: var(--color-base);
    }

    :global(.search-result-item:hover) {
      border-color: var(--color-link);
      text-decoration: none;
    }

    :global(.search-title) {
      display: block;
      color: var(--color-link);
      font-size: 16px;
      font-weight: 700;
    }

    :global(.search-summary) {
      display: block;
      margin-top: 6px;
      color: var(--color-base-subtle);
      line-height: 1.45;
    }

    :global(.search-topics) {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    :global(.search-topic) {
      display: inline-flex;
      padding: 2px 6px;
      border: 1px solid var(--border-color-subtle);
      background: var(--background-color-base);
      color: var(--color-base-subtle);
      font-size: 12px;
      line-height: 1.4;
    }
  </style>
</WikiLayout>
