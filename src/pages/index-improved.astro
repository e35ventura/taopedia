---
import '../styles/wikipedia.css';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');

// Load categories
let categoryIndex = {};
try {
  const categoryData = await import('../../public/data/categories.json');
  categoryIndex = categoryData.default;
} catch (e) {
  // Categories not yet generated
}

// Get top categories for the portal
const topCategories = Object.entries(categoryIndex)
  .sort((a: any, b: any) => b[1].length - a[1].length)
  .slice(0, 12);

// Get a random featured article
const featuredPage = pages[Math.floor(Math.random() * pages.length)];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Taopedia - The Free Encyclopedia</title>
    <meta name="description" content="The Free Encyclopedia" />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: var(--font-family-sans);
        background: #f8f9fa;
      }

      .portal-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 32px 24px 64px;
      }

      /* Header */
      .portal-header {
        text-align: center;
        margin-bottom: 32px;
        padding: 24px 0;
      }

      .portal-logo {
        font-family: var(--font-family-serif);
        font-size: 48px;
        font-weight: 400;
        color: #000;
        text-decoration: none;
        letter-spacing: 1px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
      }

      .portal-logo img {
        width: 60px;
        height: auto;
      }

      .portal-tagline {
        font-size: 16px;
        color: #54595d;
        margin-top: 4px;
      }

      /* Search */
      .portal-search {
        max-width: 600px;
        margin: 0 auto 48px;
      }

      .portal-search form {
        display: flex;
        border: 1px solid #a2a9b1;
        background: white;
      }

      .portal-search input {
        flex: 1;
        padding: 14px 16px;
        border: none;
        font-size: 16px;
        font-family: var(--font-family-sans);
      }

      .portal-search input:focus {
        outline: none;
      }

      .portal-search button {
        padding: 14px 28px;
        background: #3366cc;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: background 0.2s;
      }

      .portal-search button:hover {
        background: #2952a3;
      }

      /* Main content grid */
      .portal-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 48px;
      }

      .portal-section {
        background: white;
        border: 1px solid #a2a9b1;
        padding: 20px 24px;
      }

      .portal-section h2 {
        font-family: var(--font-family-serif);
        font-size: 20px;
        font-weight: 400;
        margin: 0 0 16px 0;
        padding-bottom: 12px;
        border-bottom: 1px solid #a2a9b1;
        color: #000;
      }

      /* Categories grid */
      .categories-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .category-item {
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 2px;
        transition: background 0.2s;
      }

      .category-item:hover {
        background: #eaecf0;
      }

      .category-item a {
        color: #3366cc;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        display: block;
        margin-bottom: 2px;
      }

      .category-item a:hover {
        text-decoration: underline;
      }

      .category-count {
        font-size: 12px;
        color: #54595d;
      }

      /* Featured article */
      .featured-article {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .featured-article h3 {
        margin: 0;
        font-size: 18px;
      }

      .featured-article h3 a {
        color: #3366cc;
        text-decoration: none;
      }

      .featured-article h3 a:hover {
        text-decoration: underline;
      }

      .featured-article p {
        margin: 0;
        color: #202122;
        line-height: 1.6;
        font-size: 14px;
      }

      .featured-article .read-more {
        color: #3366cc;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }

      /* Quick links */
      .quick-links {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .quick-links li {
        margin-bottom: 8px;
      }

      .quick-links a {
        color: #3366cc;
        text-decoration: none;
        font-size: 15px;
      }

      .quick-links a:hover {
        text-decoration: underline;
      }

      /* Stats */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }

      .stat-item {
        text-align: center;
        padding: 16px;
        background: #f8f9fa;
        border-radius: 2px;
      }

      .stat-number {
        font-size: 32px;
        font-weight: 600;
        color: #3366cc;
        font-family: var(--font-family-serif);
      }

      .stat-label {
        font-size: 13px;
        color: #54595d;
        margin-top: 4px;
      }

      /* Footer */
      .portal-footer {
        text-align: center;
        padding-top: 32px;
        border-top: 1px solid #a2a9b1;
        font-size: 13px;
        color: #54595d;
      }

      .portal-footer a {
        color: #3366cc;
        text-decoration: none;
        margin: 0 12px;
      }

      .portal-footer a:hover {
        text-decoration: underline;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .portal-container {
          padding: 24px 16px 48px;
        }

        .portal-logo {
          font-size: 36px;
        }

        .portal-logo img {
          width: 48px;
        }

        .portal-content {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .categories-grid {
          grid-template-columns: 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr;
        }

        .portal-search {
          margin-bottom: 32px;
        }

        .portal-search input {
          padding: 12px 14px;
          font-size: 15px;
        }

        .portal-search button {
          padding: 12px 20px;
        }

        .portal-section {
          padding: 16px 18px;
        }

        .portal-footer a {
          display: block;
          margin: 8px 0;
        }
      }

      @media (max-width: 480px) {
        .portal-logo {
          font-size: 28px;
          flex-direction: column;
          gap: 4px;
        }

        .portal-logo img {
          width: 40px;
        }

        .portal-tagline {
          font-size: 14px;
        }

        .portal-section h2 {
          font-size: 18px;
        }

        .stat-number {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class="portal-container">
      <!-- Header -->
      <div class="portal-header">
        <a href="/" class="portal-logo">
          <img src="/logo.svg" alt="Taopedia" />
          TAOPEDIA
        </a>
        <div class="portal-tagline">The Free Encyclopedia</div>
      </div>

      <!-- Search -->
      <div class="portal-search">
        <form action="/search" method="get">
          <input 
            type="search" 
            name="q" 
            placeholder="Search Taopedia..."
            aria-label="Search"
          />
          <button type="submit">Search</button>
        </form>
      </div>

      <!-- Main content grid -->
      <div class="portal-content">
        <!-- Browse by category -->
        <div class="portal-section">
          <h2>Browse by Category</h2>
          <div class="categories-grid">
            {topCategories.map(([cat, articles]: [string, any]) => (
              <div class="category-item">
                <a href={`/wiki/Category/${cat.replace(/ /g, '_')}`}>{cat}</a>
                <div class="category-count">{articles.length} article{articles.length !== 1 ? 's' : ''}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Featured article -->
        {featuredPage && (
          <div class="portal-section">
            <h2>Featured Article</h2>
            <div class="featured-article">
              <h3><a href={`/wiki/${featuredPage.slug}`}>{featuredPage.data.title}</a></h3>
              {featuredPage.data.summary && (
                <p>{featuredPage.data.summary}</p>
              )}
              <a href={`/wiki/${featuredPage.data slug}`} class="read-more">Read more →</a>
            </div>
          </div>
        )}

        <!-- Quick links -->
        <div class="portal-section">
          <h2>Quick Links</h2>
          <ul class="quick-links">
            <li><a href="/wiki/Special:AllPages">All articles</a></li>
            <li><a href="/wiki/Special:Categories">All categories</a></li>
            <li><a href="/search">Search</a></li>
            <li><a href="/wiki/Taopedia:About">About Taopedia</a></li>
            <li><a href="https://github.com/grant/taopedia" target="_blank">Contribute on GitHub</a></li>
          </ul>
        </div>

        <!-- Stats -->
        <div class="portal-section">
          <h2>Statistics</h2>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-number">{pages.length.toLocaleString()}</div>
              <div class="stat-label">Articles</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">{Object.keys(categoryIndex).length}</div>
              <div class="stat-label">Categories</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="portal-footer">
        <div>
          <a href="/wiki/Taopedia:About">About</a>
          <a href="/wiki/Taopedia:Privacy">Privacy</a>
          <a href="https://github.com/grant/taopedia" target="_blank">Contribute</a>
        </div>
        <div style="margin-top: 16px; font-size: 12px;">
          Made possible by gittensor
        </div>
      </div>
    </div>
  </body>
</html>
